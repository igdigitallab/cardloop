# Copy to .env and fill in values.  NEVER commit .env (it is gitignored).
# Minimal run: CLAUDE_AUTH_MODE + WEB_PASSWORD + WEB_PORT — then open http://localhost:8787.
#
# NOTE: keep every value on its own line with NO trailing inline comment.
# systemd's EnvironmentFile= parser does NOT strip inline "# ..." comments — it
# would fold them into the value (e.g. SCHEDULES_SCAN_INTERVAL="300  # ...") and
# break startup. Comments therefore live on their own lines, above each setting.

# --- Claude auth ---
# subscription (default): uses OAuth credentials from ~/.claude/.credentials.json (Claude subscription).
#   ANTHROPIC_API_KEY is forcibly removed to prevent accidental API billing.
# api_key: passes ANTHROPIC_API_KEY through to the SDK. ⚠️  THIS BILLS THE ANTHROPIC API.
CLAUDE_AUTH_MODE=subscription

# Optional: path to Claude OAuth credentials file.
# Leave empty to use the default ~/.claude/.credentials.json.
# CLAUDE_CREDENTIALS_PATH=

# Required only when CLAUDE_AUTH_MODE=api_key:
# ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram: REMOVED in v1.0 ---
# Cardloop is now web-only (PWA) + kanban auto-run. The Telegram channel was
# removed (spec-040). For the legacy Telegram-enabled version, use tag v0.13.x.

# --- engine defaults ---
DEFAULT_CWD=$HOME/projects
# Conductor pattern: fable acts as orchestrator, delegating heavy work to executor/researcher/quick
# sub-agents (sonnet/haiku) via the SDK Task tool. Change to sonnet/opus/haiku to disable.
# Requires claude CLI >= the version that recognises the "fable" alias; falls back to opus otherwise.
# Options: fable (conductor) | sonnet | opus | haiku
DEFAULT_MODEL=fable

# Sub-agent models (used by DEFAULT_AGENTS roster — Phase B, spec-017).
# Override per-agent via env; per-project overrides: Phase C.
# executor sub-agent model
EXECUTOR_MODEL=sonnet
# researcher sub-agent model (read-only: no Write/Edit)
RESEARCHER_MODEL=sonnet
# quick sub-agent model (fast/cheap lookups)
QUICK_MODEL=haiku
# conductor effort level: low|medium|high|xhigh|max (default: medium)
DEFAULT_EFFORT=medium

# --- watchdog ---
# interrupt agent after N seconds with no SDK events
STALL_SECONDS=300
# hard task time-limit in seconds (1800 = 30 min)
MAX_SECONDS=1800

# --- web cockpit ---
WEB_PORT=8787
# strong password; cockpit is public if tunnelled (CHANGE_ME is rejected at startup)
WEB_PASSWORD=CHANGE_ME
# random string; auto-generated on first run if missing
WEB_COOKIE_SALT=CHANGE_ME_RANDOM

# WEB_HOST: interface to bind on.
# 127.0.0.1 (default) = local only, safe.
# 0.0.0.0 = all interfaces (LAN / reverse proxy).  Do NOT expose to the internet without HTTPS.
WEB_HOST=127.0.0.1

# WEB_COOKIE_SECURE: set to true only when serving over HTTPS (reverse proxy / Cloudflare Tunnel).
# Must be false for plain http://LAN-IP:PORT access — browsers silently drop Secure cookies
# over http, which makes login appear broken with no error message.
WEB_COOKIE_SECURE=false

# TRUSTED_PROXIES: comma-separated proxy IPs/CIDRs. When set, the login rate-limiter
# trusts CF-Connecting-IP / X-Forwarded-For ONLY from these direct peers (so it sees
# the real client IP behind a reverse proxy). Empty (default) = ignore those headers
# and rate-limit by the socket peer. Behind a Cloudflare Tunnel use 127.0.0.1;
# behind Docker/Traefik, e.g. 172.16.0.0/12.
# TRUSTED_PROXIES=

# CARDLOOP_TUNNEL: set to 1 to bring up a public cloudflared quick tunnel on startup
# and print its URL + a scannable QR code (equivalent to `python bot.py --tunnel`).
# Opt-in only — the tunnel is a public URL protected only by WEB_PASSWORD (+ TOTP if
# enabled). Needs the `cloudflared` binary on PATH; falls back to localhost-only with
# an install hint if it's missing. See docs/remote-access.md.
# CARDLOOP_TUNNEL=

# --- personalisation (optional) ---
# VAULT_PROJECTS: absolute path to vault projects folder; empty = feature disabled
# VAULT_PROJECTS=
# operator name injected into the nudge prompt
OPERATOR_NAME=the operator
# agent reply language (e.g. "in Russian", "in English"); empty = no directive
RESPONSE_LANGUAGE=
# OPERATOR_TZ: timezone for displayed times (e.g. rate-limit reset); default UTC
# OPERATOR_TZ=UTC

# --- second opinion via Antigravity (spec-060, optional) ---
# Exposes a `second_opinion` tool that lets the agent consult a different model family
# (Google Gemini / GPT-OSS / Claude-via-Google) through the `agy` CLI, billed to the
# Google AI Pro quota instead of the Anthropic subscription. Auto-enabled ONLY when the
# `agy` binary is found; if it is absent the tool simply never appears.
# 1 = expose second_opinion when agy is present; 0 = off
SECOND_OPINION=1
# AGY_BIN: path to the agy binary (default: `which agy`, then ~/.local/bin/agy)
# AGY_BIN=
# seconds before an agy call is killed (also the Azure HTTP total timeout)
SECOND_OPINION_TIMEOUT=180
# truncate the other model's answer to protect Claude's context
SECOND_OPINION_MAX_CHARS=6000

# --- second opinion via Azure AI Foundry (spec-060 Phase B, optional) ---
# Adds a second, reliable backend to the SAME `second_opinion` tool, exposing extra model
# aliases (grok / deepseek / gpt5) routed to an Azure AI Foundry resource over HTTP, billed
# to Azure credits. Auto-enabled ONLY when both KEY and ENDPOINT are set; otherwise those
# aliases never appear and the tool falls back to Antigravity-only.
# AZURE_FOUNDRY_KEY=your-foundry-api-key
# AZURE_FOUNDRY_ENDPOINT=https://<your-foundry-name>.services.ai.azure.com
# Optional: override the alias -> deployment-name map (JSON). Defaults to
# {"grok":"grok-4-3","deepseek":"deepseek-v4","gpt5":"gpt-5-1"} — set to YOUR deployments.
# AZURE_FOUNDRY_MODELS={"grok":"grok-4-3","deepseek":"deepseek-v4","gpt5":"gpt-5-1"}
# Max output tokens per Azure call (reasoning models burn tokens before answering)
SECOND_OPINION_AZURE_MAX_TOKENS=2500

# --- persistent client (Spec 028) ---
# PERSISTENT_CLIENT: 1 = reuse ClaudeSDKClient across turns per session (experimental); 0 = off (default)
# PERSISTENT_CLIENT=0
# LIVE_CLIENT_TTL_SEC: idle seconds before an unused live client is evicted (default 600 = 10 min)
# LIVE_CLIENT_TTL_SEC=600
# LIVE_CLIENT_MAX: max concurrent live clients held in registry; LRU eviction beyond this
# LIVE_CLIENT_MAX=10
# SDK_MAX_BUFFER_BYTES: per-message JSON buffer cap for the SDK's stdout reader (bytes).
# The SDK default is 1 MiB — a single inline image or large tool_result routinely exceeds
# that and the reader kills the whole subprocess mid-turn ("Fatal error in message reader").
# SDK_MAX_BUFFER_BYTES=33554432

# --- memory alert (root-fix plan, track A2) ---
# MEMORY_ALERT_PCT: cgroup memory.current/memory.max percentage that triggers an inbox alert
# MEMORY_ALERT_PCT=80
# MEMORY_ALERT_INTERVAL_SEC: poll cadence for the memory alert loop
# MEMORY_ALERT_INTERVAL_SEC=60
# MEMORY_ALERT_COOLDOWN_SEC: minimum seconds between repeated alerts
# MEMORY_ALERT_COOLDOWN_SEC=1800

# --- crash-recovery wake (root-fix plan, track B1/A3) ---
# CRASH_STATE_FLUSH_SEC: coalescing window for the crash-recovery state snapshot
# CRASH_STATE_FLUSH_SEC=2
# MONITOR_STALE_WF_SEC: silence window before a running workflow/monitor-kind monitor is
# presumed dead (agent-kind uses transcript mtime + MONITOR_STALE_SEC instead)
# MONITOR_STALE_WF_SEC=3600
# CARD_LINGER_MAX_SEC: bounded post-turn linger for ephemeral (card) runs whose deferring
# background tasks (local_agent/local_workflow) are still open at turn end — prevents the
# card client's disconnect from SIGTERMing them mid-work. No-op when nothing is open.
# CARD_LINGER_MAX_SEC=300
# SDK_DEBUG_UNKNOWN_MESSAGES: 1 = surface the SDK's own debug line for message types
# parse_message silently drops (e.g. Agent-Teams teammate messages). Diagnostic, off by default.
# SDK_DEBUG_UNKNOWN_MESSAGES=0

# --- schedules registry (Spec 019) ---
# seconds between automatic schedule scans (default 300 = 5 min)
SCHEDULES_SCAN_INTERVAL=300
# Coolify integration (optional): if set, the Coolify scheduled-tasks API is queried on each scan.
# COOLIFY_API_TOKEN: Bearer token from Coolify Settings > API Keys
# COOLIFY_API_TOKEN=
# COOLIFY_SERVER_UUID: Server UUID from Coolify (visible in server settings)
# COOLIFY_SERVER_UUID=
# COOLIFY_API_BASE: Coolify API base URL (default: local)
# COOLIFY_API_BASE=http://localhost:8000/api/v1
# n8n integration (optional): if set, active n8n workflows with schedule triggers are collected.
# N8N_API_KEY: n8n API key (Settings > n8n API)
# N8N_API_KEY=
# N8N_HOST: n8n host:port (default: localhost:5678)
# N8N_HOST=localhost:5678

# --- deferred runs (Spec 020 Phases A-C) ---
# DEFERRED_POLL_SEC: how often the deferred-runs loop checks for due records (seconds)
# DEFERRED_POLL_SEC=30
# DEFERRED_MAX_ATTEMPTS: max fire attempts per deferred record before marking it failed
# DEFERRED_MAX_ATTEMPTS=5
# DEFERRED_FREE_THRESHOLD: fire_on_reset fires early if window utilization drops below this fraction
# DEFERRED_FREE_THRESHOLD=0.10

# --- auto-resume on rate-limit (Spec 020 Phase D) ---
# 1 = auto-queue a fire_on_reset deferred run when a run dies rate-limited (429); 0 = off
AUTO_RESUME_ON_RATE_LIMIT=1
# max consecutive auto-resumes per chain; at limit → cockpit warning, manual restart required
AUTO_RESUME_MAX=3

# --- context rotation (cost cap) ---
# Auto-rotation at the cost cap is OFF by default and opt-in PER CHAT (composer "+" menu toggle).
# CONTEXT_ROTATION: global kill-switch for the per-chat auto-rotation (default on; 0 = hard-disable)
# CONTEXT_ROTATION=1
# CONTEXT_ROTATE_AT: tokens that trigger auto-rotation when a chat opts in (default 280K)
# CONTEXT_ROTATE_AT=280000
# CONTEXT_WARN_AT: ambient "getting expensive" banner threshold (default 200K)
# CONTEXT_WARN_AT=200000

# --- ask mode: per-tool approval gate (spec-082 A) ---
# Seconds a parked tool request waits for your Allow/Deny before it auto-denies (so a turn can
# never hang forever when you are away). Default 900 (15 min).
# ASK_GATE_TIMEOUT_SEC=900

# --- Web Push (spec-053 Phase B) ---
# VAPID subject: identifies your service to push gateways. Use mailto: or https: URI.
VAPID_SUBJECT=mailto:you@example.com

# --- systemd service/unit name ---
# CARDLOOP_SERVICE: unit name used by restart-self.sh / update.sh (OSS default: cardloop)
# CARDLOOP_SERVICE=cardloop

# --- diagnostic command allowlist (log_cmd / test_cmd) ---
# DIAG_CMD_ALLOW_DIRS: colon-separated absolute dirs holding trusted wrapper
# scripts you may use as a project's log_cmd/test_cmd (e.g. a script that pulls
# remote container logs). Default empty → only the built-in tool allowlist
# (journalctl/docker/tail/head/cat/grep/pytest/python/npm/make/cargo/go) is run.
# A trailing `2>/dev/null` / `2>&1` on a log_cmd is always stripped automatically.
# DIAG_CMD_ALLOW_DIRS=/home/you/bin:/home/you/project/scripts

# --- browser module: Cloak Manager (spec-066 Tier C) ---
# Optional. Lets the agent/operator drive a logged-in persistent profile served by a
# Cloak Manager instance (set its URL + token in Settings -> Extensions -> Browser).
# CLOAK_MANAGER_CDP_BASE: host used for the raw CDP connection when it must differ from
# the REST URL — e.g. the REST API sits behind a CDN/WAF but CDP websockets need a
# directly-reachable LAN/Docker address. Falls back to the Manager URL when unset.
# CLOAK_MANAGER_CDP_BASE=http://10.0.0.5:8080
# CLOAK_PROFILE_IDLE_STOP: seconds a Manager profile THIS cockpit launched may sit with
# no attached session before we stop it again (default 900 = 15 min; 0 disables).
# A profile that was already running when we connected is the operator's and is never
# stopped, however long it idles. Without this a profile opened once stays up forever:
# two idle profiles once meant 55 Chrome processes software-rendering on a GPU-less VM
# (no passthrough → swiftshader), pinning the host at 445% CPU and 70°C for ten hours.
# Raise it if you bounce between projects a lot; a cold profile start costs seconds.
# CLOAK_PROFILE_IDLE_STOP=900

# --- browser module: captcha solving (2captcha) ---
# Optional. Enables the browser_solve_captcha agent tool for reCAPTCHA v2/v3, hCaptcha
# and Turnstile WIDGETS (a full-page Cloudflare interstitial is refused by design — its
# token is IP-bound, so a solve from someone else's address cannot be replayed here).
# Each solve costs real money on your 2captcha balance (~$0.001-0.003). Unset = the
# tool reports "not configured" and the agent is never told the tool exists.
# May instead live in the encrypted safe as `twocaptcha_api_key`, which takes priority
# ONLY if this env var is empty.
# TWOCAPTCHA_API_KEY=your-2captcha-api-key

# --- Autopilot (spec-067 Phase 0 — inert foundation; per-project opt-in) ---
# Guardrail limits for the (not-yet-wired) autonomous orchestrator. Phase 0 only
# persists these + the per-project mode (off|propose|auto, default off) and a global
# master switch (default OFF). NOTHING runs automatically until a later phase wires
# the loop. All three have safe defaults — override only to tune.
# AUTOPILOT_DAILY_TOKEN_CAP: daily token budget for autonomous runs (default 2_000_000; 0 = unlimited).
# AUTOPILOT_DAILY_TOKEN_CAP=2000000
# AUTOPILOT_MAX_CONCURRENT: max simultaneous autonomous card runs across all projects (default 1).
# AUTOPILOT_MAX_CONCURRENT=1
# AUTOPILOT_RL_RESERVE: fraction of rate-limit headroom reserved for the operator's
# interactive use — autopilot backs off above (1 - reserve) utilization (default 0.2).
# AUTOPILOT_RL_RESERVE=0.2
# Optional second agent provider. Claude remains the default; when disabled,
# saved Codex chats remain intact but cannot be started.
CODEX_ENABLED=false
# Default Codex model for new chats/cards (per-project override: codex_model).
# CODEX_MODEL=gpt-5.6-sol
