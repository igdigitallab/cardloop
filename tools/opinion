#!/usr/bin/env bash
# opinion — второе мнение от двух внешних моделей ПАРАЛЛЕЛЬНО.
#   Antigravity (agy, Google, бесплатно) + Codex (OpenAI, подписка ChatGPT Team).
# Оба по умолчанию read-only: файлы читают, менять не могут.
# Коды возврата: 0 — ответили все запрошенные; 1 — ответил не каждый; 2 — никто/ошибка вызова.
set -uo pipefail

VERSION="1.3"
AGY_MODEL="${OPINION_AGY_MODEL:-}"   # пусто → выводится из --effort (agy кодирует глубину в слаге)
CODEX_MODEL="${OPINION_CODEX_MODEL:-}"
# Профили. Дефолт — УМНЫЙ, а не быстрый: этот инструмент зовут на важных развилках,
# и дешёвая модель тут стоит дороже, чем лишняя минута ожидания.
#   --fast  дежурный прогон           --best  максимум глубины на важный вопрос
PROFILE=normal   # fast | normal | best
# Потолки ввода — ЗАМЕРЕНЫ, не взяты из документации (см. --limits):
#   codex  отдаёт честную ошибку input_too_large ровно на 1 048 576 символах;
#   agy    МОЛЧА теряет хвост промпта — на 250 КБ уже не видит конец файла,
#          при этом отвечает уверенно и с exit 0. Вот это и есть источник
#          «правдоподобного, но выдуманного» ответа, поэтому здесь гейт, а не варнинг.
CODEX_MAX_CHARS="${OPINION_CODEX_MAX_CHARS:-1048576}"
AGY_MAX_CHARS="${OPINION_AGY_MAX_CHARS:-160000}"
TIMEOUT="${OPINION_TIMEOUT:-300}"; TIMEOUT_EXPLICIT=0
EFFORT="${OPINION_EFFORT:-high}"; EFFORT_EXPLICIT=0
WORKDIR="$PWD"
WANT_AGY=1; WANT_CODEX=1; MODE=text; WRITABLE=0
declare -a FILES=(); declare -a WORDS=()

die() { echo "opinion: $*" >&2; exit 2; }
need() { [[ $2 -ge 2 ]] || die "опции $1 нужен аргумент (см. --help)"; }

usage() {
cat <<'USAGE'
opinion — два независимых внешних мнения одной командой (параллельно).

  opinion "вопрос"                  оба движка сразу: Antigravity + Codex
  opinion --agy "вопрос"            только Antigravity (Google, бесплатно)
  opinion --codex "вопрос"          только Codex (OpenAI, подписка)
  echo "вопрос" | opinion           вопрос из stdin
  opinion -f app.py -f log.txt "что тут не так?"
  opinion -- "--rw это что за флаг?"   всё после -- считается вопросом

Опции:
  --agy | --codex        только один движок (по умолчанию — оба)
  -f, --file FILE        приклеить файл к вопросу (можно повторять)
  -C, --cd DIR           рабочий каталог для движков (по умолчанию текущий)
  -t, --timeout SEC      таймаут на каждый движок (300; промпт >50 КБ сам даёт 900)
  --agy-model M          модель Antigravity (по умолчанию gemini-3.8-flash-<effort>)
  --codex-model M        модель Codex (по умолчанию из ~/.codex/config.toml)
  --effort L             глубина: low|medium|high|xhigh|max (по умолчанию high).
                         Codex — напрямую; Antigravity — через слаг модели, поэтому
                         при явной --agy-model на Antigravity уже не влияет.
  --best, --max          максимум глубины: самые сильные модели, effort=max,
                         таймаут 1800 с и контракт «цитируй или не утверждай».
                         Для вопросов, где ошибка дорого стоит
  --fast                 дежурный быстрый прогон (дешевле и слабее)
  --limits               замеренные потолки контекста обоих движков и профили
  --rw                   разрешить движкам ПИСАТЬ (по умолчанию read-only)
  --json                 машинный вывод: {"agy":{...},"codex":{...}}
  --models               показать доступные модели обоих и выйти
  -h, --help             эта справка

Коды возврата: 0 — ответили все; 1 — ответил не каждый; 2 — никто не ответил.
Модели: `opinion --models`. Расхождение между движками и есть полезный сигнал.
Приложенные файлы идут через stdin, а не argv — ограничения в 128 КБ больше нет.
Но контекст НЕ бесконечен: выше своего потолка Antigravity молча читает только начало,
поэтому такой вызов не делается вовсе. Потолки и профили — `opinion --limits`.
USAGE
}

only_positional=0
while [[ $# -gt 0 ]]; do
  if [[ $only_positional -eq 1 ]]; then WORDS+=("$1"); shift; continue; fi
  case "$1" in
    --)            only_positional=1; shift ;;
    --agy)         WANT_CODEX=0; shift ;;
    --codex)       WANT_AGY=0; shift ;;
    -f|--file)     need "$1" $#; FILES+=("$2"); shift 2 ;;
    -C|--cd)       need "$1" $#; WORKDIR="$2"; shift 2 ;;
    -t|--timeout)  need "$1" $#; TIMEOUT="$2"; TIMEOUT_EXPLICIT=1; shift 2 ;;
    --agy-model)   need "$1" $#; AGY_MODEL="$2"; shift 2 ;;
    --codex-model) need "$1" $#; CODEX_MODEL="$2"; shift 2 ;;
    --effort)      need "$1" $#; EFFORT="$2"; EFFORT_EXPLICIT=1; shift 2 ;;
    --best|--max)  PROFILE=best; shift ;;
    --fast)        PROFILE=fast; shift ;;
    --limits)      cat <<'LIM'
Замерено канареечным маркером в конце промпта (2026-09-21), не взято из документации:

  Codex        до 1 048 576 символов ввода на один запуск. Больше — честная ошибка
               input_too_large с точными числами. Весь уложившийся ввод читает целиком
               (проверено на 600 КБ: маркеры начала, середины и конца — все найдены).
  Antigravity  до ~160 000 символов читает целиком. ВЫШЕ — МОЛЧА теряет хвост и
               отвечает уверенно по началу (на 200 КБ конец файла уже не виден,
               на 600 КБ не видна и середина). Поэтому здесь жёсткий гейт.

Профили:
  --fast    codex gpt-5.6-luna    · agy gemini-3.8-flash-high · effort medium
  (дефолт)  codex gpt-6-astra     · agy gemini-3.8-flash-<effort> · effort high
  --best    codex gpt-6-astra     · agy claude-opus-4-6-thinking (>120 КБ → gemini-3.1-pro-high)
            effort max · таймаут 1800 с · плюс контракт на форму ответа (цитаты, «не знаю»)

Потолки перебиваются: OPINION_CODEX_MAX_CHARS / OPINION_AGY_MAX_CHARS.
LIM
                   exit 0 ;;
    --rw)          WRITABLE=1; shift ;;
    --json)        MODE=json; shift ;;
    --models)      echo "── Antigravity ──"; agy models 2>&1
                   echo; echo "── Codex ──"
                   python3 -c "import json;d=json.load(open('$HOME/.codex/models_cache.json'));[print(' ',m.get('slug')) for m in d['models']]" 2>/dev/null \
                     || echo "  (кэш пуст — запусти любой codex exec, он его наполнит)"
                   exit 0 ;;
    -h|--help)     usage; exit 0 ;;
    -V|--version)  echo "opinion $VERSION"; exit 0 ;;
    -)             WORDS+=("$(cat)"); shift ;;
    -*)            die "неизвестная опция $1 (вопрос с дефиса передавай после --)" ;;
    *)             WORDS+=("$1"); shift ;;
  esac
done

[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || die "--timeout ждёт число секунд, получил «$TIMEOUT»"
# xhigh/max реально поддерживаются Codex (см. supported_reasoning_levels в
# ~/.codex/models_cache.json); скрипт их раньше запрещал и тем самым отрезал
# самые сильные режимы. У agy глубина живёт в слаге и выше high не идёт.
[[ "$EFFORT" =~ ^(low|medium|high|xhigh|max)$ ]] || die "--effort ждёт low|medium|high|xhigh|max, получил «$EFFORT»"
PROMPT="${WORDS[*]:-}"
[[ -z "${PROMPT// }" && ! -t 0 ]] && PROMPT="$(cat)"
[[ -z "${PROMPT// }" ]] && die "нечего спрашивать (см. --help)"
[[ -d "$WORKDIR" ]] || die "нет каталога $WORKDIR"
WORKDIR="$(cd "$WORKDIR" && pwd)"

# agy кодирует глубину рассуждения в САМОМ слаге, отдельного --effort у него нет.
# Поэтому дефолтная модель выводится из --effort; явная --agy-model перебивает её
# целиком (и тогда --effort на Antigravity уже не влияет — он влияет на Codex).
# Профиль решает ТРИ вещи сразу: какая модель, какая глубина, сколько ждать.
# Дефолт намеренно умный, а не быстрый — «второе мнение» зовут на дорогих развилках.
case "$PROFILE" in
  fast)
    [[ -z "$CODEX_MODEL" ]] && CODEX_MODEL="gpt-5.6-luna"
    [[ -z "$AGY_MODEL"   ]] && AGY_MODEL="gemini-3.8-flash-high"
    [[ $EFFORT_EXPLICIT -eq 0 ]] && EFFORT=medium
    ;;
  best)
    # gpt-6-astra — «our most capable model for complex, demanding work» по каталогу
    # Codex; max — самая глубокая из поддерживаемых им ступеней рассуждения.
    [[ -z "$CODEX_MODEL" ]] && CODEX_MODEL="gpt-6-astra"
    [[ $EFFORT_EXPLICIT -eq 0 ]] && EFFORT=max
    # У Antigravity выбор модели упирается не в «кто умнее», а в то, кто ДОЧИТАЕТ
    # промпт: claude-opus сильнее на рассуждении, но большой ввод надёжнее держит
    # gemini-pro. Порог замерен канарейкой, не взят из головы.
    if [[ -z "$AGY_MODEL" ]]; then
      if [[ ${#PROMPT} -gt 120000 ]]; then AGY_MODEL="gemini-3.1-pro-high"
      else                                 AGY_MODEL="claude-opus-4-6-thinking"; fi
    fi
    [[ $TIMEOUT_EXPLICIT -eq 0 ]] && TIMEOUT=1800
    ;;
  *)
    # Дефолт (решение оператора 21.09.2026): gpt-6-astra со стороны Codex и flash-линейка
    # 3.8 со стороны Antigravity. Pro здесь не выигрывает: потолок контекста у обоих один
    # и тот же (~160 КБ, замерено), 3.8 — поколение новее 3.1, и оно заметно быстрее.
    # Модель agy не задаём здесь — её соберёт строка ниже из --effort, чтобы
    # `--effort low` реально опускал слаг, а не конфликтовал с ним.
    [[ -z "$CODEX_MODEL" ]] && CODEX_MODEL="gpt-6-astra"
    ;;
esac
# agy кодирует глубину в слаге и выше high не умеет — xhigh/max для него это high.
AGY_EFFORT="$EFFORT"; [[ "$AGY_EFFORT" =~ ^(xhigh|max)$ ]] && AGY_EFFORT=high
[[ -z "$AGY_MODEL" ]] && AGY_MODEL="gemini-3.8-flash-$AGY_EFFORT"

# файл ищем сперва как дан (относительно PWD), затем относительно -C
for f in ${FILES[@]+"${FILES[@]}"}; do
  p="$f"; [[ -r "$p" ]] || p="$WORKDIR/$f"
  [[ -r "$p" ]] || die "не читается файл $f"
  PROMPT+=$'\n\n--- '"$f"$' ---\n'"$(cat -- "$p")"
done

# Крупный -f — это не «тот же вопрос, только длиннее»: ответ на файл в сотни КБ идёт
# МИНУТАМИ, и дефолтные 300 с срезали его на полпути — ровно так «Codex не ответил
# по таймауту» и попадало в логи. Потолок поднимаем сами, если -t не задан явно.
if [[ $TIMEOUT_EXPLICIT -eq 0 && ${#PROMPT} -gt 50000 ]]; then
  TIMEOUT=900
  echo "opinion: промпт ${#PROMPT} Б — таймаут поднят до ${TIMEOUT}s (перебей через -t)" >&2
fi

# --best просят под вопрос с ценой ошибки, поэтому к нему прикладывается контракт
# на форму ответа. Без него обе модели охотно отвечают уверенно и мимо материала —
# это и есть «правдоподобно, но выдумано».
if [[ "$PROFILE" == best ]]; then
  PROMPT="$PROMPT"$'\n\n--- КАК ОТВЕЧАТЬ (обязательно) ---\n'
  PROMPT+=$'1. Есть приложенный материал или доступ к файлам — опирайся на них и ссылайся\n'
  PROMPT+=$'   точно: файл и строка либо прямая цитата. Проверить можно — проверь, не гадай.\n'
  PROMPT+=$'2. Материала нет — отвечай из своих знаний, это нормально, но помечай такие места\n'
  PROMPT+=$'   («по памяти, не проверял»). Чего не знаешь — говори «не знаю». Конкретику,\n'
  PROMPT+=$'   в которой не уверен (флаги, имена, версии, цифры, цитаты), НЕ выдумывай:\n'
  PROMPT+=$'   лучше назвать её неизвестной, чем подставить правдоподобную.\n'
  PROMPT+=$'3. Низкая уверенность — скажи «не уверен» и назови, чем это проверить.\n'
  PROMPT+=$'4. Сначала вывод в 2–3 строки, потом обоснование. Без вступлений и похвал.\n'
  PROMPT+=$'5. Ошибочная посылка в самом вопросе — скажи об этом первой строкой.\n'
fi

TMP="$(mktemp -d /tmp/opinion.XXXXXX)"
AGY_PID=""; CODEX_PID=""
cleanup() {
  [[ -n "$AGY_PID"   ]] && kill -- "-$AGY_PID"   2>/dev/null
  [[ -n "$CODEX_PID" ]] && kill -- "-$CODEX_PID" 2>/dev/null
  [[ -n "$AGY_PID"   ]] && kill "$AGY_PID"   2>/dev/null
  [[ -n "$CODEX_PID" ]] && kill "$CODEX_PID" 2>/dev/null
  rm -rf "$TMP"
}
trap cleanup EXIT INT TERM

# Промпт кладём на диск и скармливаем движкам через stdin — см. комментарий в run_agy.
printf '%s' "$PROMPT" >"$TMP/prompt.txt"
python3 - "$TMP/prompt.txt" "$TMP/agy.in" <<'INPY'
import json, sys
text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
msg = {"event": "user",
       "message": {"role": "user", "content": [{"type": "text", "text": text}]}}
with open(sys.argv[2], "w", encoding="utf-8") as fh:
    fh.write(json.dumps(msg, ensure_ascii=False) + "\n")
INPY

run_agy() {
  local t0=$SECONDS
  # ⚠️ ГЕЙТ, а не предупреждение. Замерено канареечным маркером в конце промпта:
  # на 160 КБ agy находит его, на 200 КБ — уже нет, и при этом отвечает уверенно
  # с exit 0. Ответ по молча усечённому вводу неотличим от нормального и хуже
  # отсутствия ответа, поэтому такой вызов не делается вовсе.
  if [[ ${#PROMPT} -gt $AGY_MAX_CHARS ]]; then
    echo "промпт ${#PROMPT} симв. > потолка Antigravity ${AGY_MAX_CHARS}: выше него agy МОЛЧА теряет хвост ввода и отвечает по началу. Сузь материал, спроси только Codex (--codex, до ${CODEX_MAX_CHARS} симв.) или подними OPINION_AGY_MAX_CHARS осознанно." >"$TMP/agy.err"
    echo 4 >"$TMP/agy.rc"; echo 0 >"$TMP/agy.sec"; return
  fi
  # ⚠️ У agy НЕТ рабочего read-only: ни --sandbox, ни --mode plan, ни урезанный
  # settings.json не держат запись в print-режиме (пишет через раз — это инструкция
  # модели, а не гейт). Единственный настоящий замок — bubblewrap.
  local -a pre=()
  if [[ $WRITABLE -eq 0 ]]; then
    command -v bwrap >/dev/null 2>&1 || { echo "нет bubblewrap — read-only для agy негарантирован; ставь 'apt install bubblewrap' или зови с --rw осознанно" >"$TMP/agy.err"; echo 3 >"$TMP/agy.rc"; echo 0 >"$TMP/agy.sec"; return; }
    pre=(bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp
         --bind "$HOME/.gemini" "$HOME/.gemini" --bind "$HOME/.cache" "$HOME/.cache"
         --die-with-parent --chdir "$WORKDIR")
  fi
  # ⚠️ Промпт уходит через stdin (stream-json), а НЕ аргументом: одиночный argv
  # упирается в MAX_ARG_STRLEN (131071 Б — это НЕ ARG_MAX), поэтому любой -f крупнее
  # ~128 КБ раньше убивал ОБА движка кодом 126 «Argument list too long».
  # Бонус: вопрос больше не светится в общесистемном `ps`.
  # ⚠️ --effort агенту НЕ передаём: у agy глубина зашита в сам слаг (…-low/-medium/-high),
  # а claude-*/gpt-oss-* флага не знают вовсе — иначе «invalid model selection … conflicts».
  local attempt rc=0
  for attempt in 1 2; do
    ( cd "$WORKDIR" && timeout "$TIMEOUT" "${pre[@]}" agy --model "$AGY_MODEL" \
        --input-format stream-json --output-format stream-json \
        --print-timeout "${TIMEOUT}s" -p "" <"$TMP/agy.in" ) >"$TMP/agy.raw" 2>"$TMP/agy.err"
    rc=$?
    # 503 «no capacity» agy помечает retryable — один повтор через 5 с
    if [[ $attempt -eq 1 ]] && grep -q '"retryable":true' "$TMP/agy.raw" "$TMP/agy.err" 2>/dev/null; then
      sleep 5; continue
    fi
    break
  done
  agy_answer "$TMP/agy.raw" >"$TMP/agy.out" 2>>"$TMP/agy.err"
  echo $rc >"$TMP/agy.rc"; echo $((SECONDS-t0)) >"$TMP/agy.sec"
}

# из NDJSON-потока agy берём только финальный ответ (event=result)
agy_answer() {
  python3 - "$1" <<'AGYPY'
import json, sys
answer = ""
for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        msg = json.loads(line)
    except Exception:
        continue
    if msg.get("event") != "result":
        continue
    res = msg.get("result") or {}
    if res.get("response"):
        answer = res["response"]
    elif res.get("error"):
        print("AGY_ERROR: " + str(res["error"]), file=sys.stderr)
sys.stdout.write(answer)
AGYPY
}

run_codex() {
  local t0=$SECONDS
  # Codex про это честен: на 1 048 576 символах он отдаёт input_too_large с точными
  # числами. Ловим заранее, чтобы не жечь минуту на заведомо отбитый запрос.
  if [[ ${#PROMPT} -gt $CODEX_MAX_CHARS ]]; then
    echo "промпт ${#PROMPT} симв. > жёсткого лимита Codex ${CODEX_MAX_CHARS} (input_too_large). Сузь материал." >"$TMP/codex.err"
    echo 4 >"$TMP/codex.rc"; echo 0 >"$TMP/codex.sec"; return
  fi
  local -a sb=(-s read-only); [[ $WRITABLE -eq 1 ]] && sb=(-s danger-full-access)
  local -a mdl=(); [[ -n "$CODEX_MODEL" ]] && mdl=(-m "$CODEX_MODEL")
  # промпт — через stdin: codex exec читает его оттуда, когда позиционного нет.
  # Тот же обход MAX_ARG_STRLEN, что и у agy.
  timeout "$TIMEOUT" codex exec --skip-git-repo-check --ephemeral --color never \
      -c model_reasoning_effort="$EFFORT" \
      -C "$WORKDIR" "${sb[@]}" "${mdl[@]}" -o "$TMP/codex.out" \
      >"$TMP/codex.err" 2>&1 <"$TMP/prompt.txt"
  echo $? >"$TMP/codex.rc"; echo $((SECONDS-t0)) >"$TMP/codex.sec"
  # codex сам печатает выбранную модель — вытаскиваем, чтобы в шапке не стояло «по умолчанию»
  awk -F': *' '/^model:/{print $2; exit}' "$TMP/codex.err" >"$TMP/codex.model" 2>/dev/null
  # НЕ подменяем ответ логом: пустой ответ должен читаться как провал, а не как успех
}

if [[ $WANT_AGY   -eq 1 ]]; then run_agy   & AGY_PID=$!;   fi
if [[ $WANT_CODEX -eq 1 ]]; then run_codex & CODEX_PID=$!; fi
[[ -n "$AGY_PID"   ]] && wait "$AGY_PID"   2>/dev/null
[[ -n "$CODEX_PID" ]] && wait "$CODEX_PID" 2>/dev/null
AGY_PID=""; CODEX_PID=""

ok_of() { # 0 = движок реально ответил
  local n="$1" rc; rc="$(cat "$TMP/$n.rc" 2>/dev/null || echo 127)"
  [[ "$rc" == "0" && -s "$TMP/$n.out" && -n "$(tr -d '[:space:]' <"$TMP/$n.out")" ]]
}
read_part() {
  local n="$1" rc; rc="$(cat "$TMP/$n.rc" 2>/dev/null || echo 127)"
  if ok_of "$n"; then cat "$TMP/$n.out"; return; fi
  case "$rc" in
    124) echo "ТАЙМАУТ ${TIMEOUT}s — ответа нет" ;;
    3)   echo "НЕ ЗАПУЩЕН: $(cat "$TMP/$n.err" 2>/dev/null)" ;;
    4)   echo "НЕ СПРОШЕН (контекст не влезает): $(cat "$TMP/$n.err" 2>/dev/null)" ;;
    0)   echo "ПУСТОЙ ОТВЕТ (движок завершился успешно, но ничего не сказал)" ;;
    *)   echo "ОШИБКА (код $rc)" ;;
  esac
  [[ "$rc" != "3" && "$rc" != "4" ]] && sed -n '1,12p' "$TMP/$n.err" 2>/dev/null
}

want=0; good=0
[[ $WANT_AGY   -eq 1 ]] && { want=$((want+1)); ok_of agy   && good=$((good+1)); }
[[ $WANT_CODEX -eq 1 ]] && { want=$((want+1)); ok_of codex && good=$((good+1)); }

if [[ "$MODE" == json ]]; then
  python3 - "$TMP" "$WANT_AGY" "$WANT_CODEX" "$AGY_MODEL" "${CODEX_MODEL:-default}" <<'PY'
import json,os,sys
tmp,wa,wc,am,cm=sys.argv[1],sys.argv[2]=="1",sys.argv[3]=="1",sys.argv[4],sys.argv[5]
def rd(p):
    try: return open(os.path.join(tmp,p),encoding="utf-8",errors="replace").read()
    except OSError: return ""
def part(n,model):
    rc=(rd(n+".rc") or "127").strip(); ans=rd(n+".out").strip()
    return {"model":model,"exit_code":int(rc),"seconds":int((rd(n+".sec") or "0").strip() or 0),
            "ok":rc=="0" and bool(ans),"answer":ans,"stderr":rd(n+".err").strip()[:2000]}
o={}
if wa: o["agy"]=part("agy",am)
if wc: o["codex"]=part("codex",(rd("codex.model").strip() or cm))
print(json.dumps(o,ensure_ascii=False,indent=2))
PY
else
  if [[ $WANT_AGY -eq 1 ]]; then
    printf '\n===== ANTIGRAVITY (%s) — %ss =====\n' "$AGY_MODEL" "$(cat "$TMP/agy.sec" 2>/dev/null || echo ?)"
    read_part agy
  fi
  if [[ $WANT_CODEX -eq 1 ]]; then
    printf '\n===== CODEX (%s, effort=%s) — %ss =====\n' "$(cat "$TMP/codex.model" 2>/dev/null || echo "${CODEX_MODEL:-?}")" "$EFFORT" "$(cat "$TMP/codex.sec" 2>/dev/null || echo ?)"
    read_part codex
  fi
  echo
fi

if   [[ $good -eq $want ]]; then exit 0
elif [[ $good -gt 0     ]]; then exit 1
else exit 2; fi
