#!/usr/bin/env bash
# opinion — второе мнение от двух внешних моделей ПАРАЛЛЕЛЬНО.
#   Antigravity (agy, Google, бесплатно) + Codex (OpenAI, подписка ChatGPT Team).
# Оба по умолчанию read-only: файлы читают, менять не могут.
# Коды возврата: 0 — ответили все запрошенные; 1 — ответил не каждый; 2 — никто/ошибка вызова.
set -uo pipefail

VERSION="1.1"
AGY_MODEL="${OPINION_AGY_MODEL:-gemini-3.8-flash-high}"
CODEX_MODEL="${OPINION_CODEX_MODEL:-}"
TIMEOUT="${OPINION_TIMEOUT:-300}"
EFFORT="${OPINION_EFFORT:-high}"
WORKDIR="$PWD"
WANT_AGY=1; WANT_CODEX=1; MODE=text; WRITABLE=0
declare -a FILES=(); declare -a WORDS=()

die() { echo "opinion: $*" >&2; exit 2; }
need() { [[ $2 -ge 2 ]] || die "опции $1 нужен аргумент (см. --help)"; }

usage() {
cat <<'USAGE'
opinion — два независимых внешних мнения одной командой (параллельно).

  opinion "вопрос"                  оба движка сразу: Antigravity + Codex
  opinion --agy "вопрос"            только Antigravity (Google, бесплатно)
  opinion --codex "вопрос"          только Codex (OpenAI, подписка)
  echo "вопрос" | opinion           вопрос из stdin
  opinion -f app.py -f log.txt "что тут не так?"
  opinion -- "--rw это что за флаг?"   всё после -- считается вопросом

Опции:
  --agy | --codex        только один движок (по умолчанию — оба)
  -f, --file FILE        приклеить файл к вопросу (можно повторять)
  -C, --cd DIR           рабочий каталог для движков (по умолчанию текущий)
  -t, --timeout SEC      таймаут на каждый движок (по умолчанию 300)
  --agy-model M          модель Antigravity (по умолчанию gemini-3.8-flash-high)
  --codex-model M        модель Codex (по умолчанию из ~/.codex/config.toml)
  --effort L             глубина рассуждения обоих: low|medium|high (по умолчанию high)
  --rw                   разрешить движкам ПИСАТЬ (по умолчанию read-only)
  --json                 машинный вывод: {"agy":{...},"codex":{...}}
  --models               показать доступные модели обоих и выйти
  -h, --help             эта справка

Коды возврата: 0 — ответили все; 1 — ответил не каждый; 2 — никто не ответил.
Модели: `opinion --models`. Расхождение между движками и есть полезный сигнал.
USAGE
}

only_positional=0
while [[ $# -gt 0 ]]; do
  if [[ $only_positional -eq 1 ]]; then WORDS+=("$1"); shift; continue; fi
  case "$1" in
    --)            only_positional=1; shift ;;
    --agy)         WANT_CODEX=0; shift ;;
    --codex)       WANT_AGY=0; shift ;;
    -f|--file)     need "$1" $#; FILES+=("$2"); shift 2 ;;
    -C|--cd)       need "$1" $#; WORKDIR="$2"; shift 2 ;;
    -t|--timeout)  need "$1" $#; TIMEOUT="$2"; shift 2 ;;
    --agy-model)   need "$1" $#; AGY_MODEL="$2"; shift 2 ;;
    --codex-model) need "$1" $#; CODEX_MODEL="$2"; shift 2 ;;
    --effort)      need "$1" $#; EFFORT="$2"; shift 2 ;;
    --rw)          WRITABLE=1; shift ;;
    --json)        MODE=json; shift ;;
    --models)      echo "── Antigravity ──"; agy models 2>&1
                   echo; echo "── Codex ──"
                   python3 -c "import json;d=json.load(open('$HOME/.codex/models_cache.json'));[print(' ',m.get('slug')) for m in d['models']]" 2>/dev/null \
                     || echo "  (кэш пуст — запусти любой codex exec, он его наполнит)"
                   exit 0 ;;
    -h|--help)     usage; exit 0 ;;
    -V|--version)  echo "opinion $VERSION"; exit 0 ;;
    -)             WORDS+=("$(cat)"); shift ;;
    -*)            die "неизвестная опция $1 (вопрос с дефиса передавай после --)" ;;
    *)             WORDS+=("$1"); shift ;;
  esac
done

[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || die "--timeout ждёт число секунд, получил «$TIMEOUT»"
[[ "$EFFORT" =~ ^(low|medium|high)$ ]] || die "--effort ждёт low|medium|high, получил «$EFFORT»"
PROMPT="${WORDS[*]:-}"
[[ -z "${PROMPT// }" && ! -t 0 ]] && PROMPT="$(cat)"
[[ -z "${PROMPT// }" ]] && die "нечего спрашивать (см. --help)"
[[ -d "$WORKDIR" ]] || die "нет каталога $WORKDIR"
WORKDIR="$(cd "$WORKDIR" && pwd)"

# файл ищем сперва как дан (относительно PWD), затем относительно -C
for f in ${FILES[@]+"${FILES[@]}"}; do
  p="$f"; [[ -r "$p" ]] || p="$WORKDIR/$f"
  [[ -r "$p" ]] || die "не читается файл $f"
  PROMPT+=$'\n\n--- '"$f"$' ---\n'"$(cat -- "$p")"
done

TMP="$(mktemp -d /tmp/opinion.XXXXXX)"
AGY_PID=""; CODEX_PID=""
cleanup() {
  [[ -n "$AGY_PID"   ]] && kill -- "-$AGY_PID"   2>/dev/null
  [[ -n "$CODEX_PID" ]] && kill -- "-$CODEX_PID" 2>/dev/null
  [[ -n "$AGY_PID"   ]] && kill "$AGY_PID"   2>/dev/null
  [[ -n "$CODEX_PID" ]] && kill "$CODEX_PID" 2>/dev/null
  rm -rf "$TMP"
}
trap cleanup EXIT INT TERM

run_agy() {
  local t0=$SECONDS
  # ⚠️ У agy НЕТ рабочего read-only: ни --sandbox, ни --mode plan, ни урезанный
  # settings.json не держат запись в print-режиме (пишет через раз — это инструкция
  # модели, а не гейт). Единственный настоящий замок — bubblewrap.
  local -a pre=()
  if [[ $WRITABLE -eq 0 ]]; then
    command -v bwrap >/dev/null 2>&1 || { echo "нет bubblewrap — read-only для agy негарантирован; ставь 'apt install bubblewrap' или зови с --rw осознанно" >"$TMP/agy.err"; echo 3 >"$TMP/agy.rc"; echo 0 >"$TMP/agy.sec"; return; }
    pre=(bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp
         --bind "$HOME/.gemini" "$HOME/.gemini" --bind "$HOME/.cache" "$HOME/.cache"
         --die-with-parent --chdir "$WORKDIR")
  fi
  ( cd "$WORKDIR" && timeout "$TIMEOUT" "${pre[@]}" agy --model "$AGY_MODEL" --effort "$EFFORT" \
      --print-timeout "${TIMEOUT}s" -p "$PROMPT" ) >"$TMP/agy.out" 2>"$TMP/agy.err"
  echo $? >"$TMP/agy.rc"; echo $((SECONDS-t0)) >"$TMP/agy.sec"
}

run_codex() {
  local t0=$SECONDS
  local -a sb=(-s read-only); [[ $WRITABLE -eq 1 ]] && sb=(-s danger-full-access)
  local -a mdl=(); [[ -n "$CODEX_MODEL" ]] && mdl=(-m "$CODEX_MODEL")
  timeout "$TIMEOUT" codex exec --skip-git-repo-check --ephemeral --color never \
      -c model_reasoning_effort="$EFFORT" \
      -C "$WORKDIR" "${sb[@]}" "${mdl[@]}" -o "$TMP/codex.out" -- "$PROMPT" \
      >"$TMP/codex.err" 2>&1 </dev/null
  echo $? >"$TMP/codex.rc"; echo $((SECONDS-t0)) >"$TMP/codex.sec"
  # codex сам печатает выбранную модель — вытаскиваем, чтобы в шапке не стояло «по умолчанию»
  awk -F': *' '/^model:/{print $2; exit}' "$TMP/codex.err" >"$TMP/codex.model" 2>/dev/null
  # НЕ подменяем ответ логом: пустой ответ должен читаться как провал, а не как успех
}

if [[ $WANT_AGY   -eq 1 ]]; then run_agy   & AGY_PID=$!;   fi
if [[ $WANT_CODEX -eq 1 ]]; then run_codex & CODEX_PID=$!; fi
[[ -n "$AGY_PID"   ]] && wait "$AGY_PID"   2>/dev/null
[[ -n "$CODEX_PID" ]] && wait "$CODEX_PID" 2>/dev/null
AGY_PID=""; CODEX_PID=""

ok_of() { # 0 = движок реально ответил
  local n="$1" rc; rc="$(cat "$TMP/$n.rc" 2>/dev/null || echo 127)"
  [[ "$rc" == "0" && -s "$TMP/$n.out" && -n "$(tr -d '[:space:]' <"$TMP/$n.out")" ]]
}
read_part() {
  local n="$1" rc; rc="$(cat "$TMP/$n.rc" 2>/dev/null || echo 127)"
  if ok_of "$n"; then cat "$TMP/$n.out"; return; fi
  case "$rc" in
    124) echo "ТАЙМАУТ ${TIMEOUT}s — ответа нет" ;;
    3)   echo "НЕ ЗАПУЩЕН: $(cat "$TMP/$n.err" 2>/dev/null)" ;;
    0)   echo "ПУСТОЙ ОТВЕТ (движок завершился успешно, но ничего не сказал)" ;;
    *)   echo "ОШИБКА (код $rc)" ;;
  esac
  [[ "$rc" != "3" ]] && sed -n '1,12p' "$TMP/$n.err" 2>/dev/null
}

want=0; good=0
[[ $WANT_AGY   -eq 1 ]] && { want=$((want+1)); ok_of agy   && good=$((good+1)); }
[[ $WANT_CODEX -eq 1 ]] && { want=$((want+1)); ok_of codex && good=$((good+1)); }

if [[ "$MODE" == json ]]; then
  python3 - "$TMP" "$WANT_AGY" "$WANT_CODEX" "$AGY_MODEL" "${CODEX_MODEL:-default}" <<'PY'
import json,os,sys
tmp,wa,wc,am,cm=sys.argv[1],sys.argv[2]=="1",sys.argv[3]=="1",sys.argv[4],sys.argv[5]
def rd(p):
    try: return open(os.path.join(tmp,p),encoding="utf-8",errors="replace").read()
    except OSError: return ""
def part(n,model):
    rc=(rd(n+".rc") or "127").strip(); ans=rd(n+".out").strip()
    return {"model":model,"exit_code":int(rc),"seconds":int((rd(n+".sec") or "0").strip() or 0),
            "ok":rc=="0" and bool(ans),"answer":ans,"stderr":rd(n+".err").strip()[:2000]}
o={}
if wa: o["agy"]=part("agy",am)
if wc: o["codex"]=part("codex",(rd("codex.model").strip() or cm))
print(json.dumps(o,ensure_ascii=False,indent=2))
PY
else
  if [[ $WANT_AGY -eq 1 ]]; then
    printf '\n===== ANTIGRAVITY (%s, effort=%s) — %ss =====\n' "$AGY_MODEL" "$EFFORT" "$(cat "$TMP/agy.sec" 2>/dev/null || echo ?)"
    read_part agy
  fi
  if [[ $WANT_CODEX -eq 1 ]]; then
    printf '\n===== CODEX (%s, effort=%s) — %ss =====\n' "$(cat "$TMP/codex.model" 2>/dev/null || echo "${CODEX_MODEL:-?}")" "$EFFORT" "$(cat "$TMP/codex.sec" 2>/dev/null || echo ?)"
    read_part codex
  fi
  echo
fi

if   [[ $good -eq $want ]]; then exit 0
elif [[ $good -gt 0     ]]; then exit 1
else exit 2; fi
