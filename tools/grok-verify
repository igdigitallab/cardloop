def _say(msg: str = "") -> None:
    print(msg, flush=True)


def check_plan(args, binary: str, version: "str | None", known, login: Path) -> "list[str]":
    """The lines `check --dry-run` prints. Pure over its arguments (no files are touched)."""
    py = " ".join(pytest_cmd())
    lines = [
        "grok-verify check — DRY RUN (no model is touched, nothing is written)",
        f"  binary        : {binary}",
        f"  version       : {version or 'UNREADABLE'}  (on KNOWN_GOOD_VERSIONS: "
        f"{'yes' if version in known else 'NO'}; list = {', '.join(known) or 'unreadable'})",
        f"  login source  : {login}  -> a chmod-600 COPY goes into a scratch GROK_HOME and is deleted afterwards",
        "  steps:",
    ]
    if not args.skip_live:
        lines.append(f"    live      {py} tests/test_grok_live.py -m {MARKER_LIVE}   (~8 real turns)")
    else:
        lines.append("    live      SKIPPED by --skip-live (verdict will be PARTIAL)")
    if not args.skip_canary:
        lines.append(f"    canary    {py} tests/test_grok_live.py -m {MARKER_CANARY}   (1 real turn, 8 MB git blob)")
    else:
        lines.append("    canary    SKIPPED by --skip-canary (verdict will be PARTIAL)")
    if args.with_cockpit:
        lines.append(f"    cockpit   {py} tests/test_grok_live_cockpit.py -m {MARKER_COCKPIT}   (~6 real turns + a real cockpit)")
    else:
        lines.append("    cockpit   not requested (add --with-cockpit)")
    if not args.skip_fixtures:
        scen = ", ".join(args.fixture_scenario) if args.fixture_scenario else "all scenarios (~26 real turns)"
        lines.append(f"    fixtures  tools/grok_record_fixtures.py -> TEMP dir, skeleton diff vs tests/fixtures/grok "
                     f"[{scen}]; drift mode: {args.drift}")
    else:
        lines.append("    fixtures  SKIPPED by --skip-fixtures (verdict will be PARTIAL)")
    lines.append("  The verdict prints the KNOWN_GOOD_VERSIONS edit only after a complete green run; "
                 "this tool never edits files.")
    return lines


def cmd_check(args) -> int:
    login = resolve_login(args.login)
    binary = resolve_binary(args.grok_bin)
    version = grok_version(binary)
    known = known_good()
    if args.dry_run:
        for ln in check_plan(args, binary, version, known, login):
            _say(ln)
        return 0 if version else 1

    _say(f"grok-verify check — {binary}")
    _say(f"  grok --version : {version or 'UNREADABLE'}")
    _say(f"  KNOWN_GOOD_VERSIONS: {', '.join(known) or '(unreadable)'} -> "
         f"{'listed' if version in known else 'NOT listed'}")
    if not version:
        _say("FAIL — the CLI version could not be read; nothing else was run")
        return 1

    secrets = secret_values(login)
    steps: "list[Step]" = []
    scratch = Scratch(login, args.scratch_dir)
    gone = False
    try:
        signed_in, calls, last = warm_login(binary, scratch.home)
        _say(f"  login warm-up : {'signed in' if signed_in else 'NOT signed in'} after {calls} `grok models` call(s)"
             + ("" if signed_in else f" ({last})") + (" — the first call refreshed the token" if signed_in and calls > 1 else ""))
        env_bin = {"GROK_BIN": binary}
        for name, marker, skip, test_file in (
                ("live", MARKER_LIVE, args.skip_live, "tests/test_grok_live.py"),
                ("canary", MARKER_CANARY, args.skip_canary, "tests/test_grok_live.py"),
                ("cockpit", MARKER_COCKPIT, not args.with_cockpit, "tests/test_grok_live_cockpit.py")):
            if skip:
                steps.append(Step(name, "skip", "skipped by flag" if name != "cockpit" else "not requested",
                                  required=name != "cockpit"))
                _say(f"  [skip] {name}")
                continue
            if not signed_in:
                steps.append(Step(name, "fail", "the login copy is not usable (`grok models` is not signed in)"))
                _say(f"  [FAIL] {name}: not run — the login copy is not usable")
                continue
            _say(f"  [run ] {name}: pytest -m {marker} ...")
            res, summary = run_pytest([test_file, "-m", marker], scratch=scratch, env_extra=env_bin,
                                      junit=scratch.root / f"{name}.xml", secrets=secrets,
                                      timeout=args.step_timeout)
            status, detail = judge_pytest(summary, res.rc, allow_skips=args.allow_skips,
                                          timed_out=res.timed_out)
            steps.append(Step(name, status, detail))
            _say(f"  [{status.upper():4}] {name}: {detail}")
            if status == "fail":
                _say(_tail(res.out))
        if args.skip_fixtures:
            steps.append(Step("fixtures", "skip", "skipped by flag"))
            _say("  [skip] fixtures")
        elif not signed_in:
            steps.append(Step("fixtures", "fail", "not run — the login copy is not usable"))
            _say("  [FAIL] fixtures: not run — the login copy is not usable")
        else:
            _say("  [run ] fixtures: re-recording the wire into a temp dir ...")
            steps.append(fixture_step(args, scratch, binary, secrets))
            s = steps[-1]
            _say(f"  [{s.status.upper():4}] fixtures: {s.detail}")
            for ln in s.extra:
                _say(ln)
    finally:
        _ignore_signals()
        gone = scratch.close()
    _say(f"  scratch tree + login copy removed: {'yes (verified)' if gone else 'NO — REMOVE ' + str(scratch.root) + ' BY HAND'}")
    if not gone:
        steps.append(Step("cleanup", "fail", f"could not remove {scratch.root}"))

    v = verdict(steps, version, known)
    _say("")
    _say(f"VERDICT: {v['text']}")
    if v["edit"]:
        loc = known_good_line()
        where = f"grok_engine.py line {loc[0]}" if loc else "grok_engine.py"
        _say(f"To record this build as verified, change {where}:")
        if loc:
            _say(f"    - {loc[1]}")
        _say(f"    + {v['edit']}")
        _say("(this tool never edits files; make the edit, run the default test suite, commit)")
    return 0 if v["ok"] else 1


def fixture_step(args, scratch: Scratch, binary: str, secrets) -> Step:
    rec = scratch.root / "rec"
    out_dir = rec / "fixtures"
    work = rec / "work"
    work.mkdir(parents=True)
    cmd = recorder_cmd() + ["--out-dir", str(out_dir), "--scratch-dir", str(work),
                            "--auth-src", str(scratch.login_copy), "--grok-bin", binary]
    for sc in (args.fixture_scenario or ["all"]):
        cmd += ["--scenario", sc]
    res = run_cmd(cmd, env=_child_env(), cwd=REPO, timeout=args.step_timeout, secrets=secrets)
    if res.timed_out:
        return Step("fixtures", "fail", "the recorder timed out")
    recorded = sorted(p.stem for p in out_dir.glob("*.jsonl")) if out_dir.is_dir() else []
    if res.rc not in (0,) or not recorded:
        step = Step("fixtures", "fail", f"the recorder exited {res.rc} and produced {len(recorded)} fixture(s)")
        step.extra = [_tail(res.out, 12)]
        return step
    committed_dir = REPO / "tests" / "fixtures" / "grok"
    names = [n for n in recorded if (committed_dir / f"{n}.jsonl").is_file()]
    missing = [n for n in recorded if n not in names]
    old = skeleton_of_dir(committed_dir, names)
    new = skeleton_of_dir(out_dir, names)
    diff = diff_skeletons(old, new)
    status, detail = judge_drift(diff, args.drift)
    detail = f"{len(names)} fixture(s) compared; " + detail
    step = Step("fixtures", status, detail)
    step.extra = render_drift(diff)
    if missing:
        step.extra.append(f"    note: no committed fixture for {', '.join(missing)} (not compared)")
    return step


