def resolve_login(arg: "str | None") -> Path:
    """The auth.json to copy: `--login` / GROK_VERIFY_LOGIN (a GROK_HOME directory or the file
    itself), default ~/.grok."""
    raw = arg or os.environ.get("GROK_VERIFY_LOGIN") or os.path.join("~", ".grok")
    p = Path(os.path.expanduser(raw))
    if p.is_dir():
        p = p / "auth.json"
    if not p.exists():
        raise UsageError(f"no login found at {p} (sign in with `tools/grok-acct login`, or point --login at one)")
    if p.name != "auth.json" or not p.is_file():
        raise UsageError(f"--login must be a GROK_HOME directory or an auth.json file, got {raw!r}")
    return p


def resolve_binary(arg: "str | None") -> str:
    raw = arg or os.environ.get("GROK_BIN", "").strip()
    candidates = [raw] if raw else ["grok", os.path.join("~", ".grok", "bin", "grok")]
    for cand in candidates:
        found = shutil.which(os.path.expanduser(cand))
        if found:
            return found
    raise UsageError("grok binary not found (--grok-bin / GROK_BIN / PATH / ~/.grok/bin/grok)")


def grok_version(binary: str, *, timeout: float = 20.0) -> "str | None":
    """`grok --version` against a throwaway GROK_HOME (the CLI creates a missing home)."""
    with tempfile.TemporaryDirectory(prefix="grok-verify-ver-") as td:
        env = _child_env({"GROK_HOME": td, "GROK_DISABLE_AUTOUPDATER": "1"})
        try:
            r = subprocess.run([binary, "--version"], env=env, capture_output=True, text=True,
                               timeout=timeout, cwd=td)
        except (OSError, subprocess.TimeoutExpired):
            return None
        return parse_version((r.stdout or "").strip())


def warm_login(binary: str, home, *, tries: int = 4, delay: float = 1.5, timeout: float = 30.0,
               sleep=time.sleep) -> "tuple[bool, int, str]":
    """Make a copied login usable before anything measures with it. The access token inside it lives a
    few hours; the FIRST `grok models` after it expired prints "You are not authenticated." while it
    refreshes the token (measured on grok 1.0.46 — a turn through ACP refreshes transparently), the
    next call says "logged in with grok.com". Call it until the CLI says so, using the engine's own
    rule for "signed in". -> (signed_in, calls made, first output line of the last call)."""
    env = _child_env({"GROK_HOME": str(home), "GROK_DISABLE_AUTOUPDATER": "1"})
    last = ""
    for n in range(1, tries + 1):
        try:
            r = subprocess.run([binary, "models"], env=env, cwd=str(home), capture_output=True, text=True,
                               timeout=timeout)
            out = ((r.stdout or "") + (r.stderr or "")).strip()
            if "logged in with grok.com" in out.lower():
                return True, n, (out.splitlines() or [""])[0][:160]
            last = (out.splitlines() or ["no output"])[0][:160]
        except (OSError, subprocess.TimeoutExpired) as exc:
            last = type(exc).__name__
        if n < tries:
            sleep(delay)
    return False, tries, last


def load_engine():
    sys.path.insert(0, str(REPO))
    import grok_engine
    return grok_engine


def known_good():
    try:
        return tuple(load_engine().KNOWN_GOOD_VERSIONS)
    except Exception:  # noqa: BLE001 — a broken engine import is reported by the steps themselves
        return ()


def known_good_line() -> "tuple[int, str] | None":
    """(line number, text) of the KNOWN_GOOD_VERSIONS assignment in grok_engine.py, read from the
    file so the hint names the line as it is today."""
    try:
        for n, line in enumerate((REPO / "grok_engine.py").read_text(encoding="utf-8").splitlines(), 1):
            if line.startswith("KNOWN_GOOD_VERSIONS"):
                return n, line
    except OSError:
        pass
    return None


class Scratch:
    """A scratch tree (parent: $GROK_VERIFY_SCRATCH / --scratch-dir / $TMPDIR) holding a COPY of the
    login in `home/auth.json` (chmod 600). `close()` removes it all, kills anything still using the
    home, and VERIFIES it is gone."""

    def __init__(self, login: Path, parent: "str | None" = None):
        base = parent or os.environ.get("GROK_VERIFY_SCRATCH") or None
        self.root = Path(tempfile.mkdtemp(prefix="grok-verify-", dir=base))
        os.chmod(self.root, 0o700)
        self.home = self.root / "home"
        self.home.mkdir(mode=0o700)
        self.login_copy = self.home / "auth.json"
        self.closed = False
        try:
            shutil.copyfile(login, self.login_copy)
            os.chmod(self.login_copy, 0o600)
        except BaseException:
            self.close()
            raise

    def close(self) -> bool:
        """True when the tree (and with it the login copy) is verified gone."""
        if self.closed:
            return not os.path.lexists(self.root)
        self.closed = True
        kill_agents(self.home)
        with contextlib.suppress(OSError):
            os.unlink(self.login_copy)
        rmtree_force(self.root)
        return not os.path.lexists(self.root)


def run_pytest(args: "list[str]", *, scratch: Scratch, env_extra: dict, junit: Path, secrets, timeout: float,
               cwd=REPO, home: "Path | None" = None) -> "tuple[CmdResult, dict]":
    cmd = pytest_cmd() + args + ["-q", "-p", "no:cacheprovider", "-o", "addopts=",
                                 f"--junitxml={junit}", f"--basetemp={scratch.root / 'pytest'}"]
    env = _child_env({"GROK_HOME": str(home or scratch.home), **env_extra})
    res = run_cmd(cmd, env=env, cwd=cwd, timeout=timeout, secrets=secrets)
    return res, parse_junit(junit)


def _tail(text: str, n: int = 25) -> str:
    lines = [ln for ln in text.splitlines() if ln.strip()]
    return "\n".join("      | " + ln[:200] for ln in lines[-n:])


