VERSION_RE = re.compile(r"^\s*grok\s+(\d+\.\d+\.\d+)\b")
_DURATION_RE = re.compile(r"^\s*(\d+(?:\.\d+)?)\s*([smhd]?)\s*$", re.I)
_UNIT = {"": 1.0, "s": 1.0, "m": 60.0, "h": 3600.0, "d": 86400.0}
_LITTER_RE = re.compile(r"^sandbox-blocked(?:-dir)?\.\d+$")
_EGRESS_RE = re.compile(r"bytes_sent max\):\s*(\d+)")
# only these markers are ever handed to pytest by this tool
MARKER_LIVE, MARKER_CANARY, MARKER_COCKPIT = "grok_live", "grok_canary", "grok_live_cockpit"

# env that must never reach a child: another account's keys, the cockpit's own secrets
_ENV_DROP_EXACT = ("XAI_API_KEY", "ANTHROPIC_API_KEY", "WEB_PASSWORD", "WEB_COOKIE_SALT")
_ENV_DROP_PREFIX = ("GROK_", "VAPID_")


class UsageError(Exception):
    """A bad flag or a missing prerequisite (exit 1, message on stderr)."""


class Terminated(BaseException):
    """SIGTERM/SIGINT/SIGHUP delivered to the main thread: unwind through every finally."""

    def __init__(self, signum: int):
        super().__init__(signum)
        self.signum = signum


