def soak_plan(args, binary, version, known, login, cycles: int, interval: float) -> "list[str]":
    canaries = (cycles // args.canary_every) if args.canary_every else 0
    return [
        "grok-verify soak — DRY RUN (no model is touched, nothing is written)",
        f"  binary        : {binary}",
        f"  version       : {version or 'UNREADABLE'}  (on KNOWN_GOOD_VERSIONS: {'yes' if version in known else 'NO'})",
        f"  login source  : {login}  -> a chmod-600 COPY goes into a scratch data dir and is deleted afterwards",
        f"  cycles        : {cycles}, one every {interval:g}s (about {cycles * interval / 3600:.2f} h)",
        f"  per cycle     : 1 tiny real turn through run_grok_engine in a scratch project (production sandbox), "
        f"then: no leftover `grok agent` of that GROK_HOME, litter <= {args.litter_max}, GROK_HOME growth "
        f"<= {args.growth_slack_mb:g} MiB + {args.growth_per_cycle_mb:g} MiB/cycle",
        f"  egress canary : {'every ' + str(args.canary_every) + ' cycles (' + str(canaries) + ' run(s))' if args.canary_every else 'off'}",
        f"  model turns   : about {cycles + (0 if args.no_preflight else 1) + canaries} "
        f"({cycles} cycles + {0 if args.no_preflight else 1} sandbox probe + {canaries} canary)",
        f"  log           : {args.log or '$GROK_VERIFY_LOG or <tmp>/grok-soak-<UTC timestamp>.jsonl'} (+ .summary.json)",
    ]


def _utc() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def default_log_path(arg: "str | None") -> Path:
    raw = arg or os.environ.get("GROK_VERIFY_LOG")
    if raw:
        return Path(os.path.expanduser(raw))
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    return Path(tempfile.gettempdir()) / f"grok-soak-{stamp}.jsonl"


def append_log(path: Path, record: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n")


def cmd_soak(args) -> int:
    duration = parse_duration(args.duration, what="--duration")
    interval = parse_duration(args.interval, what="--interval")
    cycles = plan_cycles(duration, interval, args.cycles)
    if args.canary_every < 0:
        raise UsageError("--canary-every must be >= 0")
    login = resolve_login(args.login)
    binary = resolve_binary(args.grok_bin)
    version = grok_version(binary)
    known = known_good()
    if args.dry_run:
        for ln in soak_plan(args, binary, version, known, login, cycles, interval):
            _say(ln)
        return 0 if version else 1
    if not version:
        _say("FAIL — the CLI version could not be read; nothing was run")
        return 1
    log_path = default_log_path(args.log)
    summary_path = log_path.with_name(log_path.name + ".summary.json")
    secrets = secret_values(login)
    scratch = Scratch(login, args.scratch_dir)
    meta = {"started": _utc(), "version": version, "known_good": version in known,
            "cycles_planned": cycles, "interval_sec": interval, "log": str(log_path),
            "interrupted": False, "signal": None}
    records: "list[dict]" = []
    _say(f"grok-verify soak — {binary} {version} ({'listed' if version in known else 'NOT on KNOWN_GOOD_VERSIONS'})")
    _say(f"  {cycles} cycle(s), one every {interval:g}s; log {log_path}")
    gone = False
    try:
        try:
            asyncio.run(soak_loop(args, scratch, binary, cycles, interval, log_path, secrets, records, meta))
        except Terminated as t:
            meta["interrupted"], meta["signal"] = True, t.signum
    finally:
        _ignore_signals()                    # asyncio.run restored the default disposition on exit
        gone = scratch.close()
        meta["ended"] = _utc()
        meta["scratch_removed"] = gone
        summary = summarize(records, meta)
        with contextlib.suppress(OSError):
            summary_path.parent.mkdir(parents=True, exist_ok=True)
            summary_path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    _say("")
    _say(f"scratch tree + login copy removed: {'yes (verified)' if gone else 'NO — REMOVE ' + str(scratch.root) + ' BY HAND'}")
    _say(f"SUMMARY: {summary['verdict']} — {summary['cycles_ok']}/{summary['cycles_run']} cycles ok "
         f"(planned {cycles}), max leftover agents {summary['max_leftover_agents']}, "
         f"max litter {summary['max_litter']}, canary runs {summary['canary_runs']} "
         f"(failed {summary['canary_failed']}, max bytes sent {summary['canary_max_sent']})")
    _say(f"  log     : {log_path}")
    _say(f"  summary : {summary_path}")
    if meta["interrupted"]:
        return 128 + int(meta["signal"] or 15)
    return 0 if summary["verdict"] == "PASS" and gone else 1


async def soak_loop(args, scratch: Scratch, binary: str, cycles: int, interval: float, log_path: Path,
                    secrets, records: list, meta: dict) -> None:
    loop = asyncio.get_running_loop()
    stop = asyncio.Event()
    current: "list[asyncio.Task]" = []

    def on_signal(signum: int) -> None:
        meta["interrupted"], meta["signal"] = True, signum
        stop.set()
        for t in current:
            t.cancel()
        for proc in list(_ACTIVE):          # a canary running in the executor thread must not outlive us
            threading.Thread(target=kill_group, args=(proc,), daemon=True).start()

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        loop.add_signal_handler(sig, on_signal, int(sig))

    data = scratch.root / "data"
    data.mkdir(mode=0o700)
    os.environ.pop("GROK_HOME", None)               # the engine derives <data>-grok-home, like production
    home = load_engine().grok_home({"DATA": data})  # NEXT TO data/, never inside it
    home.mkdir(mode=0o700)
    shutil.move(str(scratch.home / "auth.json"), str(home / "auth.json"))   # the one login copy moves with it
    scratch.login_copy = home / "auth.json"
    scratch.home = home
    signed_in, calls, last = await loop.run_in_executor(None, warm_login, binary, home)
    _say(f"  login warm-up: {'signed in' if signed_in else 'NOT signed in'} after {calls} `grok models` call(s)"
         + ("" if signed_in else f" ({last})") + (" — the first call refreshed the token" if signed_in and calls > 1 else ""))
    if not signed_in:
        pre = {"kind": "preflight", "ts": _utc(), "ok": False,
               "detail": f"the login copy is not usable: `grok models` says {last!r} after {calls} calls"}
        records.append(pre)
        append_log(log_path, pre)
        return
    project = scratch.root / "project"
    project.mkdir()
    (project / "README.md").write_text("soak scratch project\n", encoding="utf-8")
    os.environ.update({"GROK_ENABLED": "true", "_CARDLOOP_DATA_DIR": str(data), "GROK_BIN": binary})
    os.environ.pop("GROK_ALLOW_ALL_PROJECTS", None)
    engine = load_engine()
    engine.reset_cache()
    ctx = {"DATA": data, "running": {}}
    limits = {"litter_max": args.litter_max, "turn_timeout": args.turn_timeout}
    slack = args.growth_slack_mb * 1048576
    per_cycle = args.growth_per_cycle_mb * 1048576
    baseline: "int | None" = None

    async def guarded(coro):
        task = asyncio.ensure_future(coro)
        current.append(task)
        try:
            return await task
        finally:
            current.remove(task)

    if not args.no_preflight and not stop.is_set():
        pre = await guarded(preflight(engine))
        records.append(pre)
        append_log(log_path, pre)
        _say(f"  [{_hms()}] preflight: {'ok' if pre['ok'] else 'FAILED'} — {pre.get('detail', '')}")
        if not pre["ok"]:
            return
    for n in range(1, cycles + 1):
        if stop.is_set():
            break
        t_start = time.monotonic()
        try:
            rec = await guarded(run_cycle(engine, ctx, project, n, args.turn_timeout, args.model))
        except asyncio.CancelledError:
            break
        rec["home_bytes"] = dir_bytes(home)
        rec["litter"] = litter_count(home)
        if baseline is None:
            baseline = rec["home_bytes"]                 # first-start copies ~500 bundled files; not growth
            rec["growth_bytes"], rec["growth_allowed"] = 0, None
        else:
            rec["growth_bytes"] = rec["home_bytes"] - baseline
            rec["growth_allowed"] = growth_allowance(n - 1, slack, per_cycle)
        if args.canary_every and n % args.canary_every == 0 and not stop.is_set():
            _say(f"  [{_hms()}] egress canary ...")
            try:
                rec["canary"] = await guarded(run_canary_async(scratch, binary, secrets, args.step_timeout))
            except asyncio.CancelledError:
                rec["canary"] = {"ok": False, "detail": "interrupted"}
        rec["problems"] = evaluate_cycle(rec, limits)
        rec["ok"] = not rec["problems"]
        records.append(rec)
        append_log(log_path, rec)
        _say(f"  [{_hms()}] cycle {n}/{cycles} {'ok' if rec['ok'] else 'FAIL'} "
             f"turn={rec['duration_ms'] / 1000:.1f}s tools={rec['events'].get('tool', 0)} "
             f"leftover={len(rec['leftover'])} litter={rec['litter']} home={rec['home_bytes'] / 1048576:.1f}MiB"
             + ("".join("\n      ! " + p for p in rec["problems"]) if rec["problems"] else ""))
        if n < cycles and not stop.is_set():
            wait = wait_for_next(interval, t_start, time.monotonic())
            with contextlib.suppress(asyncio.TimeoutError):
                await asyncio.wait_for(stop.wait(), timeout=wait)


def _hms() -> str:
    return time.strftime("%H:%M:%S")


async def preflight(engine) -> dict:
    """Availability + the sandbox-denial probe (one real turn) before the first cycle."""
    t0 = time.time()
    try:
        info = await engine.provider_info(force=True)
    except Exception as exc:  # noqa: BLE001
        return {"kind": "preflight", "ts": _utc(), "ok": False, "detail": f"provider_info raised {exc!r}"[:300]}
    sandbox = info.get("sandbox") or {}
    detail = (f"available={info.get('available')} version={info.get('version')} "
              f"probe={sandbox.get('probe')} warnings={len(info.get('warnings') or [])}")
    if not info.get("available"):
        detail += f" error={str(info.get('error'))[:200]}"
    return {"kind": "preflight", "ts": _utc(), "ok": bool(info.get("available")), "detail": detail,
            "duration_ms": int((time.time() - t0) * 1000)}


async def run_cycle(engine, ctx: dict, project: Path, n: int, turn_timeout: float, model: "str | None") -> dict:
    marker = f"SOAK_{n}_{os.urandom(3).hex()}"
    prompt = (f"Run exactly this shell command with your terminal tool: echo {marker}\n"
              f"Then reply with its output and nothing else.")
    counts = {"text": 0, "tool": 0, "result": 0, "error": 0}
    state = {"error": None, "timed_out": False}
    key = f"soak:{n}"
    t0 = time.monotonic()

    async def drive():
        async for ev in engine.run_grok_engine(project_name="soak", cwd=str(project), prompt=prompt,
                                               session_key=key, ctx=ctx, effort="low", entrypoint="soak",
                                               model=model):
            kind = ev.get("type")
            if kind in ("text", "tool", "result", "error"):
                counts[kind] += 1
            if kind == "error":
                state["error"] = str(ev.get("exc"))[:300]
    try:
        await asyncio.wait_for(drive(), turn_timeout)
    except asyncio.TimeoutError:
        state["timed_out"] = True
    except asyncio.CancelledError:
        raise
    except Exception as exc:  # noqa: BLE001
        state["error"] = f"{type(exc).__name__}: {exc}"[:300]
    finally:
        ctx["running"].pop(key, None)
    home = engine.grok_home(ctx)
    leftover = find_agents(home)
    end = time.monotonic() + LEFTOVER_GRACE_SEC
    while leftover and time.monotonic() < end:
        await asyncio.sleep(0.25)
        leftover = find_agents(home)
    return {"kind": "cycle", "cycle": n, "ts": _utc(), "duration_ms": int((time.monotonic() - t0) * 1000),
            "events": counts, "result": counts["result"] > 0, "error": state["error"],
            "timed_out": state["timed_out"], "leftover": leftover}


async def run_canary_async(scratch: Scratch, binary: str, secrets, timeout: float) -> dict:
    """The egress canary as a pytest subprocess (the same test `check` runs), off the event loop."""
    def work():
        # its own home: the live tests rewrite config.toml/sandbox.toml of the home they run in, and the
        # soak's profile must not change under it
        home = scratch.root / "canary-home"
        home.mkdir(mode=0o700)
        try:
            shutil.copyfile(scratch.login_copy, home / "auth.json")
            os.chmod(home / "auth.json", 0o600)
            res, summary = run_pytest(["tests/test_grok_live.py", "-m", MARKER_CANARY, "-s"], scratch=scratch,
                                      env_extra={"GROK_BIN": binary}, home=home,
                                      junit=scratch.root / "canary.xml", secrets=secrets, timeout=timeout)
        finally:
            kill_agents(home)
            rmtree_force(home)
        status, detail = judge_pytest(summary, res.rc, timed_out=res.timed_out)
        m = _EGRESS_RE.search(res.out)
        return {"ok": status == "pass", "detail": detail, "max_sent": int(m.group(1)) if m else None}
    return await asyncio.get_running_loop().run_in_executor(None, work)


