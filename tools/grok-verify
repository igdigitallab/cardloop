def _common(p: argparse.ArgumentParser) -> None:
    p.add_argument("--login", help="GROK_HOME dir or auth.json to COPY the login from "
                                   "(env GROK_VERIFY_LOGIN, default ~/.grok)")
    p.add_argument("--grok-bin", help="the grok binary (env GROK_BIN, else PATH, else ~/.grok/bin/grok)")
    p.add_argument("--scratch-dir", help="parent of the scratch tree (env GROK_VERIFY_SCRATCH, default $TMPDIR)")
    p.add_argument("--dry-run", action="store_true", help="print what would happen; no model turn, no files")
    p.add_argument("--step-timeout", type=float, default=DEFAULT_STEP_TIMEOUT,
                   help=f"seconds one pytest/recorder step may take (default {DEFAULT_STEP_TIMEOUT:g})")


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="grok-verify", description=__doc__.split("\n\n")[0],
                                 epilog="Run `grok-verify <command> --help` for the flags of one command.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check", help="the CLI-bump gate (live + canary + fixture drift)",
                       description=__doc__)
    _common(c)
    c.add_argument("--with-cockpit", action="store_true",
                   help=f"also run pytest -m {MARKER_COCKPIT} (the whole cockpit over HTTP with the real binary)")
    c.add_argument("--skip-live", action="store_true", help="do not run the grok_live tests (verdict: PARTIAL)")
    c.add_argument("--skip-canary", action="store_true", help="do not run the egress canary (verdict: PARTIAL)")
    c.add_argument("--skip-fixtures", action="store_true", help="do not re-record/diff the fixtures (verdict: PARTIAL)")
    c.add_argument("--fixture-scenario", action="append", default=[], metavar="NAME",
                   help="re-record only this scenario (repeatable; default all)")
    c.add_argument("--drift", choices=DRIFT_MODES, default="removed",
                   help="fixture drift policy: report (never fail), removed (a removed/changed method, "
                        "field or type fails; default), any (additions fail too)")
    c.add_argument("--allow-skips", action="store_true",
                   help="a skipped test does not fail its step (default: a skip measured nothing = fail)")
    s = sub.add_parser("soak", help="the long run: N tiny real turns, process/litter/size/egress watch",
                       description=__doc__)
    _common(s)
    s.add_argument("--duration", default=DEFAULT_DURATION, help=f"total length (default {DEFAULT_DURATION}; 90s, 20m, 24h)")
    s.add_argument("--interval", default=DEFAULT_INTERVAL,
                   help=f"time between cycle STARTS (default {DEFAULT_INTERVAL}; a bare number is seconds)")
    s.add_argument("--cycles", type=int, help="exact number of cycles (overrides --duration)")
    s.add_argument("--canary-every", type=int, default=DEFAULT_CANARY_EVERY, metavar="K",
                   help=f"run the egress canary every K cycles (default {DEFAULT_CANARY_EVERY}; 0 = never)")
    s.add_argument("--log", help="JSON-lines log, one line per cycle (env GROK_VERIFY_LOG, default <tmp>/grok-soak-<ts>.jsonl)")
    s.add_argument("--litter-max", type=int, default=DEFAULT_LITTER_MAX,
                   help=f"max sandbox-blocked* placeholders left after a turn (default {DEFAULT_LITTER_MAX})")
    s.add_argument("--growth-slack-mb", type=float, default=DEFAULT_GROWTH_SLACK_MB,
                   help=f"GROK_HOME growth allowed beyond the per-cycle allowance, MiB (default {DEFAULT_GROWTH_SLACK_MB:g})")
    s.add_argument("--growth-per-cycle-mb", type=float, default=DEFAULT_GROWTH_PER_CYCLE_MB,
                   help=f"GROK_HOME growth allowed per cycle after the first, MiB (default {DEFAULT_GROWTH_PER_CYCLE_MB:g})")
    s.add_argument("--turn-timeout", type=float, default=DEFAULT_TURN_TIMEOUT,
                   help=f"seconds one turn may take (default {DEFAULT_TURN_TIMEOUT:g})")
    s.add_argument("--no-preflight", action="store_true", help="skip provider_info + the sandbox probe turn")
    s.add_argument("--model", help="Grok model id for the soak turns (default: the engine's default)")
    return ap


def _ignore_signals() -> None:
    """The cleanup (scratch tree, login copy) must finish: nothing interrupts it."""
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, signal.SIG_IGN)


def _install_signal_handlers() -> None:
    def handler(signum, _frame):
        raise Terminated(signum)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, handler)


def _reexec_in_venv() -> None:
    vpy = REPO / "venv" / "bin" / "python"
    if os.environ.get("GROK_VERIFY_NO_REEXEC") == "1" or not vpy.exists():
        return
    if os.path.realpath(sys.prefix) == os.path.realpath(REPO / "venv"):
        return
    os.execv(str(vpy), [str(vpy), str(Path(__file__).resolve()), *sys.argv[1:]])


def main(argv: "list[str] | None" = None) -> int:
    args = build_parser().parse_args(argv)
    _install_signal_handlers()
    try:
        if args.cmd == "check":
            return cmd_check(args)
        return cmd_soak(args)
    except UsageError as exc:
        print(f"grok-verify: {exc}", file=sys.stderr)
        return 1
    except Terminated as t:
        print(f"grok-verify: stopped by signal {t.signum}", file=sys.stderr)
        return 128 + t.signum


if __name__ == "__main__":
    _reexec_in_venv()
    sys.exit(main())
