def parse_duration(text, *, what: str = "duration") -> float:
    """`24h`, `20m`, `90s`, `1.5h`, `5` (plain numbers are seconds) -> seconds. Rejects 0 and junk."""
    m = _DURATION_RE.match(str(text))
    if not m:
        raise UsageError(f"{what} {text!r} is not a duration (use 5, 90s, 20m, 24h, 2d)")
    seconds = float(m.group(1)) * _UNIT[m.group(2).lower()]
    if seconds <= 0:
        raise UsageError(f"{what} must be positive, got {text!r}")
    return seconds


def plan_cycles(duration_sec: float, interval_sec: float, cycles: "int | None") -> int:
    """`--cycles` wins; otherwise as many whole intervals as fit in the duration, at least one."""
    if cycles is not None:
        if cycles < 1:
            raise UsageError("--cycles must be at least 1")
        return cycles
    return max(1, int(duration_sec // interval_sec))


def parse_version(text: str) -> "str | None":
    m = VERSION_RE.match(text or "")
    return m.group(1) if m else None


def edit_line(known, version: str) -> str:
    """The new `KNOWN_GOOD_VERSIONS = (...)` source line with `version` appended (never duplicated)."""
    versions = [v for v in known if v != version] + [version]
    inner = ", ".join(json.dumps(v) for v in versions)
    return f"KNOWN_GOOD_VERSIONS = ({inner}{',' if len(versions) == 1 else ''})"


def redact(text: str, secrets) -> str:
    for s in sorted({s for s in secrets if isinstance(s, str) and len(s) >= 8}, key=len, reverse=True):
        text = text.replace(s, "REDACTED")
    return text


def secret_values(auth_path: Path) -> "list[str]":
    """Every long string value in the login file — loaded ONLY to be scrubbed from output."""
    try:
        doc = json.loads(Path(auth_path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    out: "list[str]" = []

    def walk(node):
        if isinstance(node, dict):
            for v in node.values():
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)
        elif isinstance(node, str) and len(node) >= 16:
            out.append(node)
    walk(doc)
    return out


def rmtree_force(path) -> None:
    """rmtree that survives the mode-000 sandbox placeholders a sandboxed Grok spawn leaves."""
    def onerr(func, p, _exc):
        with contextlib.suppress(OSError):
            os.chmod(os.path.dirname(p) or ".", stat.S_IRWXU)
            os.chmod(p, stat.S_IRWXU)
        with contextlib.suppress(OSError):
            func(p)
    path = str(path)
    if not os.path.lexists(path):
        return                  # onerr would chmod the PARENT of a path that is already gone
    for root, dirs, _files in os.walk(path):
        for d in dirs:
            with contextlib.suppress(OSError):
                os.chmod(os.path.join(root, d), stat.S_IRWXU)
    shutil.rmtree(path, onerror=onerr)


def dir_bytes(path) -> int:
    """Total size of the regular files under `path` (unreadable entries are skipped)."""
    total = 0
    for root, _dirs, files in os.walk(path, onerror=lambda _e: None):
        for name in files:
            with contextlib.suppress(OSError):
                total += os.lstat(os.path.join(root, name)).st_size
    return total


def litter_count(home) -> int:
    try:
        return sum(1 for e in os.listdir(home) if _LITTER_RE.match(e))
    except OSError:
        return 0


def find_agents(home, proc_root="/proc") -> "list[dict]":
    """Live `grok agent --no-leader stdio` processes whose environment says GROK_HOME == `home`:
    [{pid, pgid, age}]. A process whose environ cannot be read is counted (when whose it is cannot
    be told, "leftover" is the safe guess). Zombies are not live."""
    proc_root = Path(proc_root)
    if not proc_root.is_dir():
        return []
    try:
        uptime: "float | None" = float((proc_root / "uptime").read_text().split()[0])
    except (OSError, ValueError, IndexError):
        uptime = None
    try:
        tck = os.sysconf("SC_CLK_TCK")
    except (ValueError, OSError, AttributeError):
        tck = 100
    want = os.path.realpath(str(home))
    found: "list[dict]" = []
    for entry in os.listdir(proc_root):
        if not entry.isdigit():
            continue
        base = proc_root / entry
        try:
            argv = (base / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if not (b"agent" in argv and b"--no-leader" in argv and b"stdio" in argv):
            continue
        try:
            envs: "list[bytes] | None" = (base / "environ").read_bytes().split(b"\0")
        except OSError:
            envs = None
        if envs is not None:
            owner = next((e[len(b"GROK_HOME="):] for e in envs if e.startswith(b"GROK_HOME=")), None)
            if owner is None or os.path.realpath(owner.decode("utf-8", "replace")) != want:
                continue
        try:
            raw = (base / "stat").read_text()
            rest = raw[raw.rindex(")") + 2:].split()
            state, pgid, start = rest[0], int(rest[2]), int(rest[19])
        except (OSError, ValueError, IndexError):
            continue
        if state == "Z":
            continue
        found.append({"pid": int(entry), "pgid": pgid,
                      "age": (uptime - start / tck) if uptime is not None else None})
    return found


def kill_agents(home, proc_root="/proc") -> int:
    """SIGKILL the process groups of every agent of OUR scratch home. Last resort of the cleanup."""
    n = 0
    for a in find_agents(home, proc_root):
        for target, fn in ((a["pgid"], os.killpg), (a["pid"], os.kill)):
            with contextlib.suppress(OSError):
                fn(target, signal.SIGKILL)
        n += 1
    return n


# ----- verdict --------------------------------------------------------------------------------

class Step:
    """One check. status: pass | fail | skip. `required` steps must pass for a green verdict."""

    def __init__(self, name: str, status: str, detail: str = "", *, required: bool = True):
        if status not in ("pass", "fail", "skip"):
            raise ValueError(status)
        self.name, self.status, self.detail, self.required = name, status, detail, required
        self.extra: "list[str]" = []        # printed under the step line (drift entries, a log tail)

    def as_dict(self) -> dict:
        return {"name": self.name, "status": self.status, "detail": self.detail, "required": self.required}


def verdict(steps, version: "str | None", known) -> dict:
    """Combine the steps. ok only when every required step passed; `edit` is the new
    KNOWN_GOOD_VERSIONS line, offered only for a COMPLETE green run of an unlisted build."""
    failed = [s for s in steps if s.status == "fail"]
    skipped = [s for s in steps if s.status == "skip" and s.required]
    ran = [s for s in steps if s.status != "skip"]
    ok = bool(version) and bool(ran) and not failed and not skipped
    edit = None
    if ok and version not in known:
        edit = edit_line(known, version)
    if failed:
        text = "FAIL — " + ", ".join(s.name for s in failed)
    elif skipped:
        text = "PARTIAL — not a gate (skipped: " + ", ".join(s.name for s in skipped) + ")"
    elif not version:
        text = "FAIL — the CLI version could not be read"
    elif not ran:
        text = "FAIL — nothing ran"
    elif version in known:
        text = f"PASS — {version} was already on KNOWN_GOOD_VERSIONS, nothing to edit"
    else:
        text = f"PASS — {version} verified"
    return {"ok": ok, "text": text, "edit": edit, "failed": [s.name for s in failed],
            "skipped": [s.name for s in skipped]}


def parse_junit(path) -> dict:
    """Counts and names out of a pytest --junitxml file. {} when it is missing or not XML."""
    try:
        root = ET.parse(str(path)).getroot()
    except (OSError, ET.ParseError):
        return {}
    out = {"passed": 0, "failed": 0, "errors": 0, "skipped": 0, "failed_names": [], "skipped_names": []}
    for case in root.iter("testcase"):
        name = case.get("name", "?")
        if case.find("failure") is not None:
            out["failed"] += 1
            out["failed_names"].append(name)
        elif case.find("error") is not None:
            out["errors"] += 1
            out["failed_names"].append(name)
        elif (sk := case.find("skipped")) is not None:
            out["skipped"] += 1
            out["skipped_names"].append(f"{name}: {(sk.get('message') or '')[:140]}")
        else:
            out["passed"] += 1
    return out


def judge_pytest(summary: dict, rc: "int | None", *, allow_skips: bool = False,
                 timed_out: bool = False) -> "tuple[str, str]":
    """(status, detail) of one pytest invocation. A run that measured nothing is not a pass: no
    tests, a skipped test (the skips here are "no binary/login/model refused" = inconclusive), a
    crash or a timeout all fail the gate."""
    if timed_out:
        return "fail", "timed out"
    total = sum(summary.get(k, 0) for k in ("passed", "failed", "errors", "skipped")) if summary else 0
    if not summary or total == 0:
        return "fail", f"no tests ran (pytest exit {rc})"
    p, f, e, s = (summary[k] for k in ("passed", "failed", "errors", "skipped"))
    head = f"{p} passed, {f} failed, {e} errors, {s} skipped"
    if f or e:
        return "fail", head + " — " + "; ".join(summary["failed_names"][:6])
    if s and not allow_skips:
        return "fail", head + " — a skipped test measured nothing: " + "; ".join(summary["skipped_names"][:4])
    if rc not in (0, None):
        return "fail", head + f" — pytest exit {rc}"
    return "pass", head


# ----- wire skeletons (fixture drift) ---------------------------------------------------------

_UUID = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")
_PLACEHOLDER = re.compile(r"^(SESSION|UUID|BLOB)_\d+$")
_HEXID = re.compile(r"^[0-9a-fA-F]{16,}$")
# dict values that carry model-authored or user data, not wire schema: the KEY is part of the
# skeleton, what is inside is not (the tool arguments and results differ run to run).
OPAQUE_KEYS = frozenset({"rawInput", "rawOutput", "input", "arguments", "output", "stdout", "stderr"})
# dict keys that are data (a model id, a session id), not field names
FREE_KEY_PARENTS = frozenset({"modelUsage"})


def _type_name(v) -> str:
    if v is None:
        return "null"
    if isinstance(v, bool):
        return "bool"
    if isinstance(v, (int, float)):
        return "number"
    if isinstance(v, str):
        return "string"
    if isinstance(v, list):
        return "array"
    return "object"


def _norm_key(key: str, parent: str) -> str:
    if parent in FREE_KEY_PARENTS or _UUID.match(key) or _PLACEHOLDER.match(key) or key.isdigit() \
            or _HEXID.match(key):
        return "<id>"
    return key


def _walk(node, path: str, out: dict, opaque: frozenset) -> None:
    out.setdefault(path, set()).add(_type_name(node))
    if isinstance(node, dict):
        leaf = path.rsplit(".", 1)[-1].rstrip("[]")
        for k, v in node.items():
            k = str(k)
            if leaf in opaque:
                continue
            _walk(v, f"{path}.{_norm_key(k, leaf)}", out, opaque)
    elif isinstance(node, list):
        for item in node:
            _walk(item, path + "[]", out, opaque)


def message_kind(msg: dict, direction: str, methods: dict) -> "str | None":
    """The event TYPE of one wire message, e.g. `a2c session/update:tool_call`, `c2a session/prompt`,
    `a2c result session/prompt`. `methods` maps request id -> method per direction of the request."""
    if not isinstance(msg, dict):
        return None
    method = msg.get("method")
    if isinstance(method, str):
        params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
        if method.startswith(("session/update", "_x.ai/session_notification", "_x.ai/session/update")):
            update = params.get("update") if isinstance(params.get("update"), dict) else params
            sub = update.get("sessionUpdate") if isinstance(update, dict) else None
            if isinstance(sub, str):
                method = f"{method}:{sub}"
        if "id" in msg:
            methods[(direction, msg["id"])] = method
            return f"{direction} request {method}"
        return f"{direction} notification {method}"
    if "result" in msg or "error" in msg:
        other = "a2c" if direction == "c2a" else "c2a"
        req = methods.get((other, msg.get("id")), "?")
        return f"{direction} {'error' if 'error' in msg else 'result'} {req}"
    return None


def skeleton(rows, opaque: frozenset = OPAQUE_KEYS) -> dict:
    """{event kind: {field path: sorted types}} over recorded rows `{"dir","msg"}` (marker rows and
    junk are skipped). Ids, text and numbers are not part of it; only presence and type of fields."""
    kinds: dict = {}
    methods: dict = {}
    for row in rows:
        if not isinstance(row, dict) or row.get("dir") not in ("c2a", "a2c"):
            continue
        msg = row.get("msg")
        kind = message_kind(msg, row["dir"], methods)
        if kind is None:
            continue
        fields = kinds.setdefault(kind, {})
        shape: dict = {}
        _walk(msg, "", shape, opaque)
        for path, types in shape.items():
            fields.setdefault(path, set()).update(types)
    return {k: {p: sorted(t) for p, t in v.items()} for k, v in kinds.items()}


def merge_skeletons(skels) -> dict:
    merged: dict = {}
    for sk in skels:
        for kind, fields in sk.items():
            tgt = merged.setdefault(kind, {})
            for path, types in fields.items():
                tgt.setdefault(path, set()).update(types)
    return {k: {p: sorted(t) for p, t in v.items()} for k, v in merged.items()}


def diff_skeletons(old: dict, new: dict) -> dict:
    """What changed from the recorded fixtures (`old`) to a fresh recording (`new`):
    methods_added / methods_removed (event kinds), fields_added / fields_removed / types_changed
    as `kind path` strings. A type set that merely gained or lost `null` is not a change."""
    out = {"methods_added": sorted(set(new) - set(old)), "methods_removed": sorted(set(old) - set(new)),
           "fields_added": [], "fields_removed": [], "types_changed": []}
    for kind in sorted(set(old) & set(new)):
        o, n = old[kind], new[kind]
        for path in sorted(set(n) - set(o)):
            out["fields_added"].append(f"{kind} {path or '.'}")
        for path in sorted(set(o) - set(n)):
            out["fields_removed"].append(f"{kind} {path or '.'}")
        for path in sorted(set(o) & set(n)):
            ot, nt = set(o[path]) - {"null"}, set(n[path]) - {"null"}
            if ot and nt and ot.isdisjoint(nt):
                out["types_changed"].append(f"{kind} {path or '.'}: {'/'.join(sorted(ot))} -> {'/'.join(sorted(nt))}")
    return out


def judge_drift(diff: dict, mode: str = "removed") -> "tuple[str, str]":
    """report: never fails; removed (default): a removed method/field or a changed type fails
    (the engine may read it), additions are only listed; any: additions fail too."""
    if mode not in DRIFT_MODES:
        raise UsageError(f"--drift must be one of {', '.join(DRIFT_MODES)}")
    breaking = len(diff["methods_removed"]) + len(diff["fields_removed"]) + len(diff["types_changed"])
    additive = len(diff["methods_added"]) + len(diff["fields_added"])
    head = (f"{breaking} removed/changed, {additive} added "
            f"(methods -{len(diff['methods_removed'])}/+{len(diff['methods_added'])}, "
            f"fields -{len(diff['fields_removed'])}/+{len(diff['fields_added'])}, "
            f"types ~{len(diff['types_changed'])})")
    if mode == "report":
        return "pass", head + " [report only]"
    if breaking or (mode == "any" and additive):
        return "fail", head
    return "pass", head


def render_drift(diff: dict, limit: int = 12) -> "list[str]":
    lines = []
    for key, label in (("methods_removed", "REMOVED method"), ("fields_removed", "REMOVED field"),
                       ("types_changed", "CHANGED type"), ("methods_added", "added method"),
                       ("fields_added", "added field")):
        items = diff[key]
        for it in items[:limit]:
            lines.append(f"    {label}: {it}")
        if len(items) > limit:
            lines.append(f"    ... {len(items) - limit} more {label} entries")
    return lines


def load_jsonl_rows(path) -> "list[dict]":
    rows = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                with contextlib.suppress(ValueError):
                    row = json.loads(line)
                    if isinstance(row, dict):
                        rows.append(row)
    except OSError:
        pass
    return rows


def skeleton_of_dir(directory, names=None) -> dict:
    """Merged skeleton of the recorded fixtures `names` (stems) in `directory`; every non-synthetic
    fixture when None."""
    d = Path(directory)
    files = sorted(d.glob("*.jsonl"))
    picked = [f for f in files if (f.stem in names if names is not None else not f.stem.startswith("synthetic_"))]
    return merge_skeletons(skeleton(load_jsonl_rows(f)) for f in picked)


# ----- soak: one cycle's verdict, growth allowance, summary ----------------------------------

def growth_allowance(cycles_since_baseline: int, slack_bytes: float, per_cycle_bytes: float) -> float:
    return slack_bytes + per_cycle_bytes * max(0, cycles_since_baseline)


def wait_for_next(interval: float, started: float, now: float) -> float:
    """Seconds to sleep so that cycle STARTS are `interval` apart: the turn's own time counts."""
    return max(0.0, interval - (now - started))


def evaluate_cycle(m: dict, limits: dict) -> "list[str]":
    """Problems of one finished soak cycle (empty = healthy). `m` carries what was measured."""
    problems = []
    if m.get("timed_out"):
        problems.append(f"turn timed out after {limits.get('turn_timeout')}s")
    elif m.get("error"):
        problems.append(f"turn error: {m['error']}")
    elif not m.get("result"):
        problems.append("the turn ended without a result event")
    leftover = m.get("leftover") or []
    if leftover:
        oldest = max((a.get("age") or 0) for a in leftover)
        problems.append(f"{len(leftover)} grok agent process(es) of this GROK_HOME survived the turn "
                        f"(oldest {int(oldest)}s)")
    if m.get("litter", 0) > limits["litter_max"]:
        problems.append(f"{m['litter']} sandbox-blocked* placeholders in GROK_HOME (max {limits['litter_max']})")
    growth = m.get("growth_bytes")
    allowed = m.get("growth_allowed")
    if growth is not None and allowed is not None and growth > allowed:
        problems.append(f"GROK_HOME grew {growth / 1048576:.1f} MiB since the baseline "
                        f"(allowed {allowed / 1048576:.1f} MiB)")
    canary = m.get("canary")
    if canary and not canary.get("ok"):
        problems.append("egress canary failed: " + str(canary.get("detail", ""))[:200])
    return problems


def summarize(records: "list[dict]", meta: dict) -> dict:
    cycles = [r for r in records if r.get("kind") == "cycle"]
    canaries = [r["canary"] for r in cycles if r.get("canary")]
    sizes = [r["home_bytes"] for r in cycles if r.get("home_bytes") is not None]
    failed = [r["cycle"] for r in cycles if not r.get("ok")]
    pre_failed = any(r.get("kind") == "preflight" and not r.get("ok") for r in records)
    interrupted = bool(meta.get("interrupted"))
    if interrupted:
        text = "INTERRUPTED"
    elif pre_failed or failed or not cycles or any(not c.get("ok") for c in canaries):
        text = "FAIL"
    elif len(cycles) < meta.get("cycles_planned", 0):
        text = "FAIL"
    else:
        text = "PASS"
    return {
        **meta,
        "cycles_run": len(cycles),
        "cycles_ok": sum(1 for r in cycles if r.get("ok")),
        "cycles_failed": failed,
        "max_leftover_agents": max((len(r.get("leftover") or []) for r in cycles), default=0),
        "max_litter": max((r.get("litter", 0) for r in cycles), default=0),
        "home_bytes_first": sizes[0] if sizes else None,
        "home_bytes_last": sizes[-1] if sizes else None,
        "canary_runs": len(canaries),
        "canary_failed": sum(1 for c in canaries if not c.get("ok")),
        "canary_max_sent": max((c.get("max_sent") or 0 for c in canaries), default=0),
        "preflight_ok": not pre_failed,
        "verdict": text,
    }


# ---------------------------------------------------------------------------------------------
# process helpers
# ---------------------------------------------------------------------------------------------

def _child_env(extra: "dict | None" = None) -> dict:
    env = {k: v for k, v in os.environ.items()
           if k not in _ENV_DROP_EXACT and not k.startswith(_ENV_DROP_PREFIX)}
    env.update(extra or {})
    return env


def kill_group(proc: "subprocess.Popen", *, grace: float = 20.0) -> None:
    """Stop a child and everything in its session. SIGINT first (pytest unwinds its finalizers, which
    is what lets the engine kill ITS process groups), then SIGTERM, then SIGKILL."""
    for sig, wait in ((signal.SIGINT, grace), (signal.SIGTERM, 5.0), (signal.SIGKILL, 5.0)):
        if proc.poll() is not None and not _group_alive(proc.pid):
            return
        with contextlib.suppress(OSError):
            os.killpg(proc.pid, sig)
        end = time.monotonic() + wait
        while time.monotonic() < end:
            if proc.poll() is not None and not _group_alive(proc.pid):
                return
            time.sleep(0.1)
    with contextlib.suppress(OSError, subprocess.TimeoutExpired):
        proc.wait(timeout=2)


def _group_alive(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


class CmdResult:
    def __init__(self, rc, out, timed_out):
        self.rc, self.out, self.timed_out = rc, out, timed_out


_ACTIVE: "set[subprocess.Popen]" = set()      # children a signal handler must be able to stop


def run_cmd(cmd, *, env: dict, cwd, timeout: float, secrets=()) -> CmdResult:
    """Run `cmd` in its own session with merged stdout/stderr; the whole group dies on timeout, on
    an exception, or on a signal delivered to this tool. Output is redacted."""
    proc = subprocess.Popen(cmd, env=env, cwd=str(cwd), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, errors="replace", start_new_session=True)
    timed_out = False
    out = ""
    _ACTIVE.add(proc)
    try:
        try:
            out, _ = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            timed_out = True
            kill_group(proc)
            out, _ = proc.communicate()
    except BaseException:
        kill_group(proc)
        raise
    finally:
        _ACTIVE.discard(proc)
        if _group_alive(proc.pid):          # the leader is gone; stragglers of its group are not wanted
            with contextlib.suppress(OSError):
                os.killpg(proc.pid, signal.SIGKILL)
    return CmdResult(proc.returncode, redact(out or "", secrets), timed_out)


def pytest_cmd() -> "list[str]":
    raw = os.environ.get("GROK_VERIFY_PYTEST", "").strip()
    return shlex.split(raw) if raw else [sys.executable, "-m", "pytest"]


def recorder_cmd() -> "list[str]":
    raw = os.environ.get("GROK_VERIFY_RECORDER", "").strip()
    return shlex.split(raw) if raw else [sys.executable, str(REPO / "tools" / "grok_record_fixtures.py")]


